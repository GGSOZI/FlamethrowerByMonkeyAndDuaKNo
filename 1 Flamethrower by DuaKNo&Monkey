-- where the nozzle goes: the fuel port on your tank (or your back if the gun is a store model)
local function portNozzleCF()
	local rig = activeRig
	if rig and rig.model.Parent and rig.root.Parent then
		return rig.root.CFrame * NOZZLE_PORT
	end
	local r = getRoot()
	if r then
		return r.CFrame * CFrame.new(1.4, 0.3, 1.3) * CFrame.Angles(0, math.rad(90), 0)
	end
	return nil
end

local function setDisplay(st, status, litres, color)
	st.statusLbl.Text = status
	st.litreLbl.Text = litres
	if color then
		st.statusLbl.TextColor3 = color
		st.lamp.Color = color
		st.lampLight.Color = color
	end
end

local function litresText(st)
	return string.format("%.1f L", st.added / CFG.FUEL_MAX * CFG.TANK_LITRES)
end

local function stopFlow(st)
	if st.flow then
		st.flow:Stop()
		st.flow:Destroy()
		st.flow = nil
	end
end

local function abortRefuel(st, why)
	if st.state ~= "extending" and st.state ~= "fueling" then return end
	st.state = "retracting"
	stopFlow(st)
	setDisplay(st, "DISCONNECTED", litresText(st), RED)
	notify("Fuel station", why, 3)
end

pumpClick = function(st)
	if not st or st.state ~= "fueling" then return end
	local now = os.clock()
	if now - (st.lastClick or 0) < 0.07 then return end
	st.lastClick = now
	st.pending += CFG.PUMP_PER_CLICK
	st.squeeze = 0.12
	playSoundAt(st.nozzle, CFG.SOUNDS.PUMP_CLICK, { Volume = 0.8 })
end

local function startRefuel(st)
	if refueling then return end
	if not findFlameTool() then
		notify("Fuel station", "You need the flamethrower.", 3)
		return
	end
	if fuel >= CFG.FUEL_MAX - 0.5 then
		notify("Fuel station", "Your tank is already full.", 2)
		return
	end
	if not portNozzleCF() then return end
	refueling = st
	st.state = "extending"
	st.ext = 0
	st.added = 0
	st.pending = 0
	st.prompt.Enabled = false
	setDisplay(st, "CONNECTING", "0.0 L", AMBER)
end

local function stationHoseCollide(st)
	local cf = st.base
	return function(pts, n)
		for i = 2, n - 1 do
			local l = cf:PointToObjectSpace(pts[i])
			local x, y, z = l.X, l.Y, l.Z
			local onIsland = math.abs(x) < 2.3 and math.abs(z) < 1.5
			local floorY = onIsland and 0.55 or 0.1
			if y < floorY then y = floorY end
			-- keep it out of the pump body
			if math.abs(x) < 1.0 and y < 4.0 and math.abs(z) < 0.7 then
				local dx, dz = 1.0 - math.abs(x), 0.7 - math.abs(z)
				if dx < dz then
					x = (x >= 0 and 1 or -1) * 1.0
				else
					z = (z >= 0 and 1 or -1) * 0.7
				end
			end
			pts[i] = cf:PointToWorldSpace(Vector3.new(x, y, z))
		end
	end
end

local function stationStep(st, dt)
	local active = st.state ~= "idle"
	if not active and st.settle <= 0 then return end
	st.settle = math.max(0, st.settle - dt)
	local now = os.clock()

	local target
	if active then
		target = portNozzleCF()
		if target then st.lastTarget = target end
		if st.state == "extending" or st.state == "fueling" then
			local char = getChar()
			local root = getRoot()
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not root or not hum or hum.Health <= 0 then
				abortRefuel(st, "Fueling interrupted.")
			elseif (root.Position - st.base.Position).Magnitude > CFG.STATION_LEAVE_DIST then
				abortRefuel(st, "You walked off with the nozzle still in. It popped out.")
			end
		end
	end

	if st.state == "extending" then
		st.ext = math.min(1, st.ext + dt / 0.7)
		if st.ext >= 1 then
			st.state = "fueling"
			playSoundAt(st.nozzle, CFG.SOUNDS.CONNECT, { Volume = 1 })
			st.flow = playSoundAt(st.nozzle, CFG.SOUNDS.FUEL_LOOP, { Looped = true, Volume = 0.8 })
			setDisplay(st, "CLICK NOZZLE", litresText(st), AMBER)
			notify("Fuel station", "Nozzle is in. Click the nozzle (or the PUMP button) again and again to fill the tank.", 5)
		end
	elseif st.state == "fueling" then
		st.ext = 1
		-- fuel only flows from clicks: each click queues some, the queue drains smoothly
		local add = math.min(st.pending, 70 * dt, CFG.FUEL_MAX - fuel)
		if add > 0 then
			st.pending -= add
			fuel += add
			st.added += add
			updateFuelUI()
			st.litreLbl.Text = litresText(st)
			if st.statusLbl.Text ~= "PUMPING" then st.statusLbl.Text = "PUMPING" end
		elseif st.pending <= 0 and st.statusLbl.Text ~= "CLICK NOZZLE" then
			st.statusLbl.Text = "CLICK NOZZLE"
		end
		st.lampLight.Brightness = 1.6 + math.sin(now * 8) * 0.8
		if fuel >= CFG.FUEL_MAX - 0.01 then
			fuel = CFG.FUEL_MAX
			lowWarned = false
			updateFuelUI()
			stopFlow(st)
			playSoundAt(st.nozzle, CFG.SOUNDS.REFILL, { Volume = 1 })
			setDisplay(st, "FULL", litresText(st), GREEN)
			notify("Fuel station", "Tank full.", 2)
			st.state = "retracting"
		end
	elseif st.state == "retracting" then
		st.ext = math.max(0, st.ext - dt / 0.6)
		if st.ext <= 0 then
			st.state = "idle"
			st.settle = 2
			if refueling == st then refueling = nil end
			st.prompt.Enabled = true
			st.lampLight.Brightness = 1.4
			setDisplay(st, "READY", "0.0 L", GREEN)
		end
	end

	local e = easeInOut(st.ext)
	local dest = target or st.lastTarget or st.restCF
	local nzCF = st.restCF:Lerp(dest, e) + Vector3.new(0, math.sin(e * math.pi) * 0.5, 0)
	if st.squeeze > 0 then
		st.squeeze -= dt
		nzCF = nzCF * CFrame.new((math.random() - 0.5) * 0.035, (math.random() - 0.5) * 0.035, 0)
		st.leverW.C0 = st.leverBase * CFrame.Angles(math.rad(-28), 0, 0)
	else
		st.leverW.C0 = st.leverBase
	end
	st.hl.Enabled = st.state == "fueling"
	if st.hl.Enabled then
		st.hl.OutlineTransparency = 0.25 + (math.sin(now * 7) + 1) * 0.25
	end
	st.nozzle.CFrame = nzCF

	local A = st.hoseStart
	local B = (nzCF * CFrame.new(0, 0, 0.5)).Position
	local len = HOSE_MIN + (HOSE_MAX - HOSE_MIN) * e
	if (st.state == "extending" or st.state == "fueling") and (A - B).Magnitude > HOSE_MAX - 0.2 then
		abortRefuel(st, "The hose ran out of slack. The nozzle popped out.")
	end
	ropeStep(st.rope, A, B, len, st.collide)
	ropeRender(st.rope, st.segs, 0.13)
end

