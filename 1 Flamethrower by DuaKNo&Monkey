	}, head)
	make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 10), Size = UDim2.new(1, -44, 0, 24),
		Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Left,
		Text = "FLAMETHROWER",
	}, head)
	make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 34), Size = UDim2.new(1, -44, 0, 16),
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Left,
		Text = "by DuaKNo & Monkey   -   drag this bar to move",
	}, head)
	make("Frame", {
		BackgroundColor3 = Color3.fromRGB(44, 44, 50), Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromOffset(0, 61), BorderSizePixel = 0,
	}, card)

	make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 72), Size = UDim2.new(1, -32, 0, 16),
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Left,
