-- minimize (to a small square) and resize
local minimized = false
local userSized = false
local fullW, fullH = 214, 200
local MIN_W, MIN_H, MAX_W, MAX_H = 170, 110, 520, 640
local SQUARE = 36
local titleLbl = bar:FindFirstChildOfClass("TextLabel")

local squareLbl = label(bar, "FT", TXT, Enum.TextXAlignment.Center)
squareLbl.Size = UDim2.fromScale(1, 1)
squareLbl.Visible = false

local function applySize()
	if minimized then
		win.Size = UDim2.fromOffset(SQUARE, SQUARE)
	else
		win.Size = UDim2.fromOffset(fullW, fullH)
	end
end

local grip = Instance.new("TextButton")
grip.Name = "ResizeGrip"
grip.AnchorPoint = Vector2.new(1, 1)
grip.Position = UDim2.fromScale(1, 1)
grip.Size = UDim2.fromOffset(20, 20)
grip.BackgroundTransparency = 1
grip.Text = ""
grip.AutoButtonColor = false
grip.ZIndex = 5
grip.Parent = win
for i, len in ipairs({ 14, 9, 4 }) do
	local line = Instance.new("Frame")
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.Size = UDim2.fromOffset(len, 2)
	line.Position = UDim2.new(1, -9 + (i - 1) * 3, 1, -9 + (i - 1) * 3)
	line.Rotation = -45
	line.BackgroundColor3 = DIM
	line.BorderSizePixel = 0
	line.ZIndex = 5
	line.Parent = win
end

local rsDrag, rsStart, rsSize = false, nil, nil
grip.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		rsDrag = true
		rsStart = input.Position
		rsSize = win.AbsoluteSize
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then rsDrag = false end
		end)
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if rsDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - rsStart
		fullW = math.clamp(rsSize.X + d.X, MIN_W, MAX_W)
		fullH = math.clamp(rsSize.Y + d.Y, MIN_H, MAX_H)
		userSized = true
		applySize()
		clampToScreen(win)
	end
end)

list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	if not userSized then
		fullH = math.clamp(list.AbsoluteContentSize.Y + 14 + 22, MIN_H, MAX_H)
		applySize()
	end
	clampToScreen(win)
end)

local function setMinimized(v)
	minimized = v
	body.Visible = not v
	grip.Visible = not v
	minBtn.Visible = not v
	if titleLbl then titleLbl.Visible = not v end
	squareLbl.Visible = v
	for _, c in ipairs(win:GetChildren()) do
		if c:IsA("Frame") and c ~= bar and c ~= body then c.Visible = not v end
	end
	bar.Size = v and UDim2.fromScale(1, 1) or UDim2.new(1, 0, 0, 22)
	applySize()
	clampToScreen(win)
end

-- tap the square (without dragging it) to open the window again
do
	local tapAt
	bar.InputBegan:Connect(function(input)
		if not minimized then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			tapAt = input.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					if minimized and tapAt and (input.Position - tapAt).Magnitude < 6 then
						setMinimized(false)
					end
					tapAt = nil
				end
			end)
		end
	end)
end

task.defer(function()
	if not userSized then
		fullH = math.clamp(list.AbsoluteContentSize.Y + 14 + 22, MIN_H, MAX_H)
	end
	applySize()
end)
minBtn.MouseButton1Click:Connect(function() setMinimized(true) end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and gui.Enabled and input.KeyCode == Enum.KeyCode.M then setMinimized(not minimized) end
end)

end -- main window

