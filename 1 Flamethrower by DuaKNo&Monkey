		NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.6, 0.35), NumberSequenceKeypoint.new(1, 1),
	})
	em.Color = CFG.seq3(CFG.pal().npc)
	em.Parent = parent
	return em
end

local function makeSmokeEmitter(parent, rate, size)
	local em = Instance.new("ParticleEmitter")
	em.Texture = "rbxasset://textures/particles/smoke_main.dds"
	em.Rate = rate
	em.Lifetime = NumberRange.new(1.4, 2.6)
	em.Speed = NumberRange.new(3, 6)
	em.SpreadAngle = Vector2.new(20, 20)
	em.Acceleration = Vector3.new(0, 6, 0)
	em.LightEmission = 0
	em.Rotation = NumberRange.new(0, 360)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 3.5) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	em.Color = ColorSequence.new(Color3.fromRGB(48, 46, 46), Color3.fromRGB(22, 22, 22))
	em.Parent = parent
	return em
end

local function setFireIntensity(state, k)
	for _, e in ipairs(state.flames) do
		if e.em.Parent then e.em.Rate = e.rate * k end
	end
	for _, e in ipairs(state.smokes) do
		if e.em.Parent then e.em.Rate = e.rate * math.max(k, 0.25) end
	end
	if state.light and state.light.Parent then
		state.light.Brightness = (1.2 + math.random() * 1.1) * k
	end
end

local function removeFire(state)
	for _, e in ipairs(state.flames) do
		if e.em.Parent then e.em:Destroy() end
	end
	for _, e in ipairs(state.smokes) do
		if e.em.Parent then e.em:Destroy() end
	end
	if state.light and state.light.Parent then state.light:Destroy() end
	if state.blood and state.blood.Parent then state.blood:Destroy() end
	state.flames, state.smokes = {}, {}
	if state.scream then
		state.scream:Stop()
		state.scream:Destroy()
		state.scream = nil
	end
end

local function killNPC(model, state)
	if state.dead then return end
	state.dead = true
	state.deathTime = os.clock()
	if state.scream then
		state.scream:Stop()
		state.scream:Destroy()
		state.scream = nil
	end
	if state.blood and state.blood.Parent then
		state.blood.Rate = 0
		state.blood:Emit(35)
	end
	local khum = state.hum
	if khum and khum.Parent then
		khum.BreakJointsOnDeath = false   -- joints stay, the ragdoll constraints drop the body
		khum.RequiresNeck = false
	end
	ragdoll(model)
	CFG.NET.kill(model)
	local prof = getProfile(model)
	applyLevel(model, 1)
	stripTextures(model)
	say(model, "...")

	local hum = state.hum
	if hum and hum.Parent then
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
	end

	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if root then
		playSoundAt(root, CFG.SOUNDS.DEATH, { Volume = 1 })
		-- heavy dark smoke from the corpse
		local att = Instance.new("Attachment")
		att.Parent = root
		local sm = makeSmokeEmitter(att, 10, 2.2)
		sm.Lifetime = NumberRange.new(2.2, 3.8)
		task.delay(14, function()
			if sm.Parent then sm.Enabled = false end
			Debris:AddItem(att, 5)
		end)
		-- pool of blood spreads under the body, a few more wounds open up
		task.delay(0.6, function()
			if root.Parent then bloodOnGround(root.Position, 3.2 + math.random() * 1.6, 9, (CFG.CORPSE_TIME or 0) > 0 and CFG.CORPSE_TIME + 30 or 600, model) end
		end)
	end
	for _ = 1, 4 do bloodOnBody(model, prof, true) end
	kills += 1
	updateKillLabel()

	-- the corpse fades away after CORPSE_TIME seconds
	if (CFG.CORPSE_TIME or 0) > 0 then
		task.delay(CFG.CORPSE_TIME, function()
			if not model.Parent then return end
			local TweenService = game:GetService("TweenService")
			local h = model:FindFirstChildOfClass("Humanoid")
			if h then
				h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				h.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			end
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
					TweenService:Create(d, TweenInfo.new(1.5), { Transparency = 1 }):Play()
				elseif d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
			end
			task.delay(1.6, function()
				local st = burning[model]
				if st then
					removeFire(st)
					burning[model] = nil
				end
				if model.Parent then model:Destroy() end
			end)
		end)
	end
end

local function ignite(model, hum, napalm)
	local state = burning[model]
	local life = CFG.BURN_TIME * (napalm and 3 or 1)
	if state then
		state.expire = math.max(state.expire, os.clock() + life)
		return
	end
	if hum.Health <= 0 then return end

	local prof = getProfile(model)
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false

	state = {
		hum = hum, flames = {}, smokes = {}, start = os.clock(), expire = os.clock() + life, nextSpread = 0,
		nextBlood = 0, nextDrip = 0, nextSay = 0, nextTurn = 0, nextVis = 0, dir = Vector3.new(1, 0, 0),
		drips = 0, maxHealth = math.max(hum.MaxHealth, 1),
	}
	burning[model] = state
	local ownRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if ownRoot then task.spawn(CFG.NET.claim, ownRoot, 1.5) end
	hum.WalkSpeed = CFG.PANIC_SPEED
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer

	for _, part in ipairs(prof.body) do
		if part.Size.Magnitude >= 1.3 then
			local f = math.clamp(part.Size.Magnitude / 2.2, 0.5, 1.5)
			table.insert(state.flames, { em = makeFlameEmitter(part, 1.5 * f), rate = 16 + 10 * f })
			if part.Name == "Head" or part.Name == "UpperTorso" or part.Name == "Torso" then
				table.insert(state.smokes, { em = makeSmokeEmitter(part, 5, 1.2), rate = 5 })
			end
		end
	end

	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
	if torso then
		local l = Instance.new("PointLight")
		l.Color = CFG.pal().light
		l.Range = 14
		l.Brightness = 2
		l.Parent = torso
		state.light = l

		-- droplets spraying off the body
		local b = Instance.new("ParticleEmitter")
		b.Texture = "rbxasset://textures/particles/smoke_main.dds"
		b.Rate = 6
		b.Lifetime = NumberRange.new(0.5, 0.9)
		b.Speed = NumberRange.new(4, 9)
		b.SpreadAngle = Vector2.new(180, 180)
		b.Acceleration = Vector3.new(0, -48, 0)
		b.LightEmission = 0
		b.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0.08) })
		b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.8) })
		b.Color = ColorSequence.new(Color3.fromRGB(150, 6, 6), Color3.fromRGB(80, 6, 6))
		b.Enabled = CFG.BLOOD
		b.Parent = torso
		state.blood = b
	end

	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if root then
		playSoundAt(root, CFG.SOUNDS.IGNITE, { Volume = 0.9 })
		local list = CFG.SOUNDS.SCREAM
		state.scream = playSoundAt(root, list[math.random(1, #list)], {
			Looped = true, Volume = 1, PlaybackSpeed = 0.9 + math.random() * 0.35,
		})
	end
	bloodOnBody(model, prof, false)
	bloodOnBody(model, prof, false)
	say(model, CFG.SCREAM_LINES[math.random(1, #CFG.SCREAM_LINES)])
end

CFG.igniteFn = ignite

local function burnStep(model, state, dt, now)
	local hum = state.hum
	if not model.Parent or not hum.Parent then
		removeFire(state)
		burning[model] = nil
		return
	end

	-- corpse: flames die down slowly, then it's just smoke and blood
	if state.dead then
		local k = 1 - (now - state.deathTime) / 7
		if k <= 0 then
			removeFire(state)
			burning[model] = nil
		else
			setFireIntensity(state, k)
		end
		return
	end

	if hum.Health <= 0 then
		killNPC(model, state)
		return
	end

	-- fire went out (it dies down over FADE_TIME first)
	if now > state.expire + CFG.FADE_TIME then
		removeFire(state)
		burning[model] = nil
		if ragdollData[model] then
			task.delay(CFG.RECOVER_DELAY, function()
				if model.Parent and hum.Health > 0 and not burning[model] then unragdoll(model) end
			end)
		else
			hum.WalkSpeed = 10
		end
		return
	end

	local fk = 1
	if now > state.expire then fk = math.clamp(1 - (now - state.expire) / CFG.FADE_TIME, 0, 1) end
	local newHealth = hum.Health - CFG.BURN_DPS * dt * math.max(fk, 0.25)
	if newHealth <= 0 then
		killNPC(model, state)
		return
	end
	hum.Health = newHealth
	local p = 1 - hum.Health / state.maxHealth
	setFireIntensity(state, fk)

	-- a burning NPC sets close-by NPCs on fire
	if CFG.SPREAD and fk > 0.4 and now >= state.nextSpread then
		state.nextSpread = now + 0.6
		local sroot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		if sroot then
			local ps = OverlapParams.new()
			ps.FilterType = Enum.RaycastFilterType.Exclude
			ps.FilterDescendantsInstances = { fxFolder, model, getChar() }
			local seen = {}
			for _, part in ipairs(Workspace:GetPartBoundsInRadius(sroot.Position, CFG.SPREAD_RADIUS, ps)) do
				local m = part:FindFirstAncestorOfClass("Model")
				if m and not seen[m] then
					seen[m] = true
					local h = m:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 and not burning[m] and not Players:GetPlayerFromCharacter(m) and math.random() < 0.45 then
						ignite(m, h)
					end
				end
			end
		end
	end

	if now >= state.nextVis then
		state.nextVis = now + 0.1
		local prof = getProfile(model)
		prof.level = math.max(prof.level, p)
		applyLevel(model, prof.level)
	end

	-- more blood as it gets worse
	if state.blood then state.blood.Rate = 4 + p * 14 end
	local prof = getProfile(model)
	if now >= state.nextBlood and p > 0.05 then
		state.nextBlood = now + 0.9 - p * 0.5
		bloodOnBody(model, prof, p > 0.5)
	end
	if now >= state.nextDrip and p > 0.1 and state.drips < 14 then
		state.nextDrip = now + 0.7
		state.drips += 1
		local root = model:FindFirstChild("HumanoidRootPart")
		if root then
			bloodOnGround(root.Position + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 3, 0.3 + math.random() * 0.5, 1.6, 90, model)
		end
	end

	if not ragdollData[model] and now - state.start >= CFG.RAGDOLL_DELAY then
		ragdoll(model)
		flail(model, 1)
		state.nextFlail = now + 0.5
	end
	if ragdollData[model] then
		if now >= (state.nextFlail or 0) then
			state.nextFlail = now + 1.1
			flail(model, 0.2)
		end
	else
		if now >= state.nextTurn then
			state.nextTurn = now + 0.5 + math.random() * 0.7
			local a = math.random() * math.pi * 2
			state.dir = Vector3.new(math.cos(a), 0, math.sin(a))
			if math.random() < 0.2 then hum.Jump = true end
		end
		hum:Move(state.dir, false)
	end

	if now >= state.nextSay then
		state.nextSay = now + 1.5
		say(model, CFG.SCREAM_LINES[math.random(1, #CFG.SCREAM_LINES)])
	end
	if hum.Health <= 0 then killNPC(model, state) end
end

RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	for model, state in pairs(burning) do
		burnStep(model, state, dt, now)
	end
end)

