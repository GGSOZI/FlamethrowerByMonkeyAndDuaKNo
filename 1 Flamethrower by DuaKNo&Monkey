-- every item: { part, born, update = function(item, age) -> keepAlive }
local fxItems = {}
local MAX_FX = 450

local function addFx(item)
	item.born = os.clock()
	table.insert(fxItems, item)
	while #fxItems > MAX_FX do
		local old = table.remove(fxItems, 1)
		if old.part and old.part.Parent then old.part:Destroy() end
		if old.onEnd then old.onEnd(old) end
	end
end

task.spawn(function()
	while not CFG.FT.stopped do
		task.wait(0.12)
		local now = os.clock()
		for i = #fxItems, 1, -1 do
			local it = fxItems[i]
			if not it.part.Parent then
				if it.onEnd then it.onEnd(it) end
				table.remove(fxItems, i)
			else
				local ok, alive = pcall(it.update, it, now - it.born)
				if not ok or not alive then
					if it.part.Parent then it.part:Destroy() end
					if it.onEnd then it.onEnd(it) end
					table.remove(fxItems, i)
				end
			end
		end
	end
end)

------------------------------------------------------------------ BLOOD
local BLOOD_WET = Color3.fromRGB(150, 8, 8)
local BLOOD_MID = Color3.fromRGB(94, 10, 9)
local BLOOD_DRY = Color3.fromRGB(52, 15, 11)

local function bloodStep(it, age)
	-- grows for a bit, then slowly turns from bright red to dark brown crust
	local g = math.min(age / it.grow, 1)
	g = 1 - (1 - g) * (1 - g)
	it.part.Size = Vector3.new(0.05, math.max(it.sy * g, 0.05), math.max(it.sz * g, 0.05))
	local c
	if age < 5 then
		c = BLOOD_WET:Lerp(BLOOD_MID, age / 5)
	else
		c = BLOOD_MID:Lerp(BLOOD_DRY, math.min((age - 5) / 30, 1))
	end
	it.part.Color = c
	it.part.Reflectance = 0.28 * (1 - math.min(age / 14, 1))
	if age > 14 and it.part.Material ~= Enum.Material.Slate then
		it.part.Material = Enum.Material.Slate
	end
	return not it.lifetime or age < it.lifetime
end

-- blood stuck on the NPC itself (welded, so it moves with the body and stays on the corpse)
local function bloodOnBody(model, prof, big)
	if not CFG.BLOOD then return end
	local candidates = prof.body
	if #candidates == 0 then return end
	local part = candidates[math.random(#candidates)]
	local s = part.Size
	local axes = { Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis }
	if part.Name == "Head" then table.insert(axes, Vector3.yAxis) end
	local n = axes[math.random(#axes)]
	local face = Vector3.new(n.X * s.X / 2, n.Y * s.Y / 2, n.Z * s.Z / 2)
	local tang = Vector3.new((math.random() - 0.5) * s.X * 0.7, (math.random() - 0.5) * s.Y * 0.7, (math.random() - 0.5) * s.Z * 0.7)
	tang = tang - n * tang:Dot(n)
	local lp = face + tang + n * 0.02
	local wpos = part.CFrame:PointToWorldSpace(lp)
	local wn = part.CFrame:VectorToWorldSpace(n)

	local folder = model:FindFirstChild("Blood")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Blood"
		folder.Parent = model
	end
	if #folder:GetChildren() > 40 then return end

	local d = (big and 0.7 or 0.3) + math.random() * (big and 0.7 or 0.4)
	local streak = math.random() < 0.5
	local blob = Instance.new("Part")
	blob.Shape = CYL
	blob.Size = Vector3.new(0.05, 0.05, 0.05)
	blob.Color = BLOOD_WET
	blob.Material = Enum.Material.SmoothPlastic
	blob.Reflectance = 0.28
	blob.CanCollide = false
	blob.CanQuery = false
	blob.CanTouch = false
	blob.Massless = true
	blob.CastShadow = false
	blob.CFrame = discCF(wpos, wn)
	blob.Parent = folder
	local w = Instance.new("WeldConstraint")
	w.Part0 = part
	w.Part1 = blob
	w.Parent = blob
	addFx({
		part = blob, update = bloodStep, grow = 2.5 + math.random() * 2,
		sy = d * (streak and 1.8 or 1), sz = d * (streak and 0.7 or 1),
	})
end

-- blood on the ground (drips and the pool under a body)
local function bloodOnGround(pos, diameter, growTime, lifetime, ignoreModel)
	if not CFG.BLOOD then return end
	local ignore = { fxFolder }
	if ignoreModel then table.insert(ignore, ignoreModel) end
	local g, n = groundAt(pos + Vector3.new(0, 2, 0), ignore)
	local blob = fxPart(Vector3.new(0.05, 0.05, 0.05), BLOOD_WET, Enum.Material.SmoothPlastic, CYL)
	blob.CFrame = discCF(g + n * (0.03 + math.random() * 0.02), n, Vector3.new(math.random() - 0.5, 0, math.random() - 0.5))
	local ratio = 0.7 + math.random() * 0.5
	addFx({ part = blob, update = bloodStep, grow = growTime or 2, sy = diameter, sz = diameter * ratio, lifetime = lifetime or 120 })
end

------------------------------------------------------------------ SCORCH + GROUND FIRE
local groundFires = 0

local function groundFire(pos, normal, napalm, child)
	if groundFires >= (napalm and 16 or 12) then return end
	groundFires += 1
	local pal = CFG.pal()
	local scale = napalm and (child and 1.2 or 1.7) or 1
	local life = napalm and (child and CFG.NAPALM_LIFE * 0.5 or CFG.NAPALM_LIFE) or (3.2 + math.random() * 1.4)
	local p = fxPart(Vector3.new(1, 0.2, 1), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
	p.Transparency = 1
	p.CFrame = CFrame.lookAt(pos, pos + normal) * CFrame.Angles(math.rad(-90), 0, 0)
	local att = Instance.new("Attachment")
	att.Parent = p
	local em = Instance.new("ParticleEmitter")
	em.Texture = "rbxasset://textures/particles/fire_main.dds"
	em.Rate = 22 * scale
	em.Lifetime = NumberRange.new(0.6, 1.1)
	em.Speed = NumberRange.new(2, 5)
	em.SpreadAngle = Vector2.new(25, 25)
	em.LightEmission = 1
	em.Rotation = NumberRange.new(0, 360)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.3 * scale), NumberSequenceKeypoint.new(1, 0.2 * scale) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	em.Color = ColorSequence.new(pal.ground[1], pal.ground[2])
	em.Parent = att
	local light = Instance.new("PointLight")
	light.Color = pal.light
	light.Range = 9 * scale
	light.Brightness = 1.6
	light.Parent = p

	local baseRate, baseBright = em.Rate, light.Brightness
	local radius = napalm and 5 or 3
	local nextSpread = os.clock() + 0.4
	local nextCreep = os.clock() + 2 + math.random() * 2

	-- the patch burns at full strength for a while, then dies down slowly instead of switching off
	addFx({
		part = p,
		onEnd = function() groundFires -= 1 end,
		update = function(it, age)
			local left = life - age
			if left <= 0 then return false end
			local k = math.clamp(left / (life * 0.6), 0, 1)
			em.Rate = baseRate * k
			light.Brightness = baseBright * (0.25 + 0.75 * k)
			local now = os.clock()

			-- anything standing in the fire catches it
			if CFG.SPREAD and k > 0.3 and now >= nextSpread then
				nextSpread = now + 0.5
				local ps = OverlapParams.new()
				ps.FilterType = Enum.RaycastFilterType.Exclude
				ps.FilterDescendantsInstances = { fxFolder }
				local seen = {}
				for _, part in ipairs(Workspace:GetPartBoundsInRadius(pos + normal * 1.5, radius, ps)) do
					local m = part:FindFirstAncestorOfClass("Model")
					if m and not seen[m] and not Players:GetPlayerFromCharacter(m) then
						seen[m] = true
						local h = m:FindFirstChildOfClass("Humanoid")
						if h and h.Health > 0 then CFG.igniteFn(m, h, napalm) end
					end
				end
			end

			-- napalm creeps: it starts small new patches around itself
			if napalm and not child and CFG.SPREAD and k > 0.5 and now >= nextCreep then
				nextCreep = now + 2.5 + math.random() * 2
				local ang = math.random() * math.pi * 2
				local off = Vector3.new(math.cos(ang), 0, math.sin(ang)) * (2 + math.random() * 2.5)
				local g2, n2 = groundAt(pos + off, { fxFolder, getChar() })
				groundFire(g2 + n2 * 0.03, n2, true, true)
			end
			return true
		end,
	})

	-- black mark that stays a while, then fades
	local mark = fxPart(Vector3.new(0.05, (2.2 + math.random() * 1.4) * scale, (2.2 + math.random() * 1.4) * scale), Color3.fromRGB(12, 12, 12), Enum.Material.Slate, CYL)
	mark.Transparency = 0.3
	mark.CFrame = discCF(pos + normal * 0.03, normal, Vector3.new(math.random() - 0.5, 0, math.random() - 0.5))
	addFx({ part = mark, update = function(it, age)
		if age > 14 then it.part.Transparency = math.min(0.3 + (age - 14) / 14, 1) end
		return age < 28
	end })
end

------------------------------------------------------------------ NPC PROFILE (original colours, body parts, clothes)
local burning = {}
local spawned = {}
local profiles = setmetatable({}, { __mode = "k" })
local ragdollData = setmetatable({}, { __mode = "k" })
local kills = 0
local updateKillLabel = function() end

local SKIN_RED = Color3.fromRGB(172, 42, 34)
local SCORCH = Color3.fromRGB(78, 24, 19)
local CHAR_BLACK = Color3.fromRGB(13, 12, 12)

local function burnColor(orig, p)
	if p <= 0 then return orig end
	if p < 0.35 then return orig:Lerp(SKIN_RED, p / 0.35) end
	if p < 0.65 then return SKIN_RED:Lerp(SCORCH, (p - 0.35) / 0.3) end
	return SCORCH:Lerp(CHAR_BLACK, math.min((p - 0.65) / 0.35, 1))
end

local function getProfile(model)
	local prof = profiles[model]
	if prof then return prof end
	prof = { parts = {}, cloth = {}, body = {}, level = 0, shown = -1, faces = {} }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(prof.parts, { part = d, color = d.Color, mat = d.Material })
			if d.Parent == model and d.Name ~= "HumanoidRootPart" then
				table.insert(prof.body, d)
			end
		elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
			table.insert(prof.cloth, { inst = d, color = d.Color3 })
		elseif d:IsA("Decal") and d.Name == "face" then
			table.insert(prof.faces, d)
		end
	end
	profiles[model] = prof
	return prof
end

local function applyLevel(model, p)
	local prof = getProfile(model)
	if math.abs(p - prof.shown) < 0.01 then return end
	prof.shown = p
	local rocky = p > 0.55
	for _, e in ipairs(prof.parts) do
		if e.part.Parent then
			e.part.Color = burnColor(e.color, p)
			if rocky and e.part.Material ~= Enum.Material.Slate then
				e.part.Material = Enum.Material.Slate
			end
		end
	end
	for _, c in ipairs(prof.cloth) do
		if c.inst.Parent then c.inst.Color3 = burnColor(c.color, p) end
	end
	if p > 0.6 then
		for _, f in ipairs(prof.faces) do
			if f.Parent then f.Transparency = math.clamp((p - 0.6) / 0.3, 0, 1) end
		end
	end
end

-- final look: no clothes, no face, no textures, just charred black rock
local function stripTextures(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("Decal") or d:IsA("SurfaceAppearance") then
			d:Destroy()
		elseif d:IsA("MeshPart") then
			d.TextureID = ""
		end
	end
end

