local function spawnNPC()
	local root = getRoot()
	if not root then return end

	for i = #spawned, 1, -1 do
		if not spawned[i].Parent then table.remove(spawned, i) end
	end
	if #spawned >= CFG.MAX_NPCS then
		notify("NPC limit", "Max " .. CFG.MAX_NPCS .. ". Clear some first.", 3)
		return
	end

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromUserId(player.UserId)
	end)
	if not ok or not model then
		notify("Spawn failed", "Couldn't load your avatar.", 3)
		return
	end

	model.Name = "NPC"
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayName = "NPC"
		hum.MaxHealth = 100
		hum.Health = 100
		hum.BreakJointsOnDeath = false
		hum.RequiresNeck = false
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
		hum.HealthDisplayDistance = 100
		hum.NameDisplayDistance = 100
	end
	local pos = root.Position + root.CFrame.LookVector * (10 + math.random() * 4) + root.CFrame.RightVector * (math.random() - 0.5) * 8
	local g = groundAt(pos)
	local spawnPos = g + Vector3.new(0, 3.5, 0)
	model:PivotTo(CFrame.lookAt(spawnPos, Vector3.new(root.Position.X, spawnPos.Y, root.Position.Z)))
	model.Parent = Workspace
	table.insert(spawned, model)
	task.delay(0.3, function() if model.Parent then say(model, "hello") end end)

	playSoundAt(model:FindFirstChild("HumanoidRootPart") or root, CFG.SOUNDS.SPAWN, { Volume = 0.7 })
end

local function clearNPCs()
	for _, m in ipairs(spawned) do
		local s = burning[m]
		if s then
			removeFire(s)
			burning[m] = nil
		end
		if m.Parent then m:Destroy() end
	end
	spawned = {}
	for _, it in ipairs(fxItems) do
		if it.part.Parent then it.part:Destroy() end
	end
	table.clear(fxItems)
	notify("Cleared", "NPCs and blood removed.", 2)
end

------------------------------------------------------------------ NPC ANIMATIONS (your own animations)
-- Reads the animation ids from YOUR character's Animate script (idle / walk / run / jump / fall) and plays
-- them on every spawned NPC, so they move exactly like you. No Animate script found -> the old built-in walk is used.
do
	local rigs = setmetatable({}, { __mode = "k" })
	local idsCache

	local function readIds()
		local char = getChar()
		local animate = char and char:FindFirstChild("Animate")
		if animate then
			local ids, any = {}, false
			for _, group in ipairs(animate:GetChildren()) do
				local list = {}
				for _, a in ipairs(group:GetChildren()) do
					if a:IsA("Animation") and a.AnimationId ~= "" then table.insert(list, a.AnimationId) end
				end
				if #list > 0 then
					ids[string.lower(group.Name)] = list
					any = true
				end
			end
			if any then idsCache = ids end
		end
		return idsCache
	end

	local function build(hum)
		local ids = readIds()
		if not ids then return nil end
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = hum
		end
		local tracks = {}
		local function load(name, priority, looped)
			local list = ids[name]
			if not list then return end
			local a = Instance.new("Animation")
			a.AnimationId = list[1]
			local ok, tr = pcall(function() return animator:LoadAnimation(a) end)
			if ok and tr then
				tr.Looped = looped
				tr.Priority = priority
				tracks[name] = tr
			end
		end
		load("idle", Enum.AnimationPriority.Idle, true)
		load("walk", Enum.AnimationPriority.Core, true)
		load("run", Enum.AnimationPriority.Core, true)
		load("jump", Enum.AnimationPriority.Action, false)
		load("fall", Enum.AnimationPriority.Action, true)
		if next(tracks) == nil then return nil end
		return { tracks = tracks }
	end

	local FALLBACK = { run = { "run", "walk", "idle" }, walk = { "walk", "run", "idle" }, idle = { "idle" }, fall = { "fall", "jump", "idle" } }

	local function play(r, want, speed)
		local name
		for _, n in ipairs(FALLBACK[want]) do
			if r.tracks[n] then name = n break end
		end
		if not name then return end
		if r.cur ~= name then
			if r.cur and r.tracks[r.cur] then r.tracks[r.cur]:Stop(0.2) end
			r.cur = name
			r.tracks[name]:Play(0.2)
		end
		if name == "walk" or name == "run" then
			r.tracks[name]:AdjustSpeed(math.clamp(speed / 14.5, 0.3, 2.2))
		end
	end

	local function stopAll(r)
		if r.cur and r.tracks[r.cur] then r.tracks[r.cur]:Stop(0.1) end
		r.cur = nil
	end

	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, m in ipairs(spawned) do
			local hum = m.Parent and m:FindFirstChildOfClass("Humanoid")
			local root = m:FindFirstChild("HumanoidRootPart")
			if hum and root then
				local r = rigs[m]
				if r == nil or (r.retry and now > r.retry) then
					r = build(hum) or { retry = now + 2 }
					rigs[m] = r
				end
				if r.tracks then
					local posed = CFG.isPosed and CFG.isPosed(m)
					-- burning NPCs keep the arms-up panic pose of the full version
					if hum.Health <= 0 or ragdollData[m] or posed or (burning[m] and not CFG.LITE) then
						if r.cur then stopAll(r) end
						CFG.animActive[m] = nil
					else
						CFG.animActive[m] = true
						local v = root.AssemblyLinearVelocity
						local sp = Vector3.new(v.X, 0, v.Z).Magnitude
						local want = "idle"
						if hum.FloorMaterial == Enum.Material.Air then
							want = "fall"
						elseif sp > 14 then
							want = "run"
						elseif sp > 0.8 then
							want = "walk"
						end
						play(r, want, sp)
					end
				end
			end
		end
	end)
end

