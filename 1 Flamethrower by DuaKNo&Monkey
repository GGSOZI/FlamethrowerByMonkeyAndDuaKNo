				local cy = math.clamp(ap.Y, 0, math.max(vs.Y - as.Y, 0))
				if cx ~= ap.X or cy ~= ap.Y then
					card.Position = card.Position + UDim2.fromOffset(cx - ap.X, cy - ap.Y)
				end
			end
		end)
