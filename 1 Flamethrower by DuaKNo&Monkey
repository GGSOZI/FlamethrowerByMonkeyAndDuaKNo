			BackgroundColor3 = Color3.fromRGB(30, 30, 35), BorderSizePixel = 0,
			AutoButtonColor = false, Text = "", ClipsDescendants = true,
		}, card)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, b)
		local stroke = make("UIStroke", { Color = accent, Thickness = 1.5, Transparency = 0.78 }, b)
		make("Frame", { BackgroundColor3 = accent, Size = UDim2.new(0, 4, 1, 0), BorderSizePixel = 0 }, b)

