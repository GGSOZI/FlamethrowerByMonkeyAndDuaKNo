------------------------------------------------------------------ ROPE (verlet) used for the gun hose and the pump hose
local function newRope(n)
	return { pts = {}, prev = {}, n = n, t = os.clock() }
end

local function ropeFill(r, A, B)
	for i = 1, r.n do
		local t = (i - 1) / (r.n - 1)
		local p = A:Lerp(B, t) + Vector3.new(0, -math.sin(t * math.pi) * 0.4, 0)
		r.pts[i] = p
		r.prev[i] = p
	end
end

local function ropeStep(r, A, B, length, collide)
	local now = os.clock()
	local dt = math.clamp(now - r.t, 1 / 240, 1 / 20)
	r.t = now
	local pts, prev, n = r.pts, r.prev, r.n
	local rest = length / (n - 1)
	local g = Vector3.new(0, -70 * dt * dt, 0)

	for i = 2, n - 1 do
		local p = pts[i]
		pts[i] = p + (p - prev[i]) * 0.96 + g
		prev[i] = p
	end
	for _ = 1, 10 do
		pts[1], pts[n] = A, B
		for i = 1, n - 1 do
			local d = pts[i + 1] - pts[i]
			local m = d.Magnitude
			if m > rest then
				local corr = d * ((m - rest) / m)
				if i == 1 then
					pts[i + 1] = pts[i + 1] - corr
				elseif i + 1 == n then
					pts[i] = pts[i] + corr
				else
					pts[i] = pts[i] + corr * 0.5
					pts[i + 1] = pts[i + 1] - corr * 0.5
				end
			end
		end
		if collide then collide(pts, n) end
	end
	pts[1], pts[n] = A, B
end

local function ropeMakeSegments(parent, count, thickness, color, mat)
	local segs = {}
	for i = 1, count do
		local s = Instance.new("Part")
		s.Name = "Seg" .. i
		s.Shape = CYL
		s.Size = Vector3.new(0.3, thickness, thickness)
		s.Color = color
		s.Material = mat or Enum.Material.SmoothPlastic
		s.Anchored = true
		s.CanCollide = false
		s.CanQuery = false
		s.CanTouch = false
		s.CastShadow = false
		s.TopSurface = Enum.SurfaceType.Smooth
		s.BottomSurface = Enum.SurfaceType.Smooth
		s.Parent = parent
		segs[i] = s
	end
	return segs
end

local function ropeRender(r, segs, thickness)
	for i = 1, #segs do
		local pa, pb = r.pts[i], r.pts[i + 1]
		local len = (pb - pa).Magnitude
		if len > 0.001 then
			segs[i].Size = Vector3.new(len + 0.03, thickness, thickness)
			segs[i].CFrame = CFrame.lookAt((pa + pb) / 2, pb) * ZAX
		end
	end
end

