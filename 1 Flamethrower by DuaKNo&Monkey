local fit = { x = 0, y = 0, z = 0, pitch = 0, yaw = 0, roll = 0 }
local shiftLockOn = false
local menuFree = false      -- true while you hold Ctrl/Alt or pressed M: the mouse is free so you can click the menu
for k, v in pairs(CFG.GUN_FIT or {}) do
	if fit[k] ~= nil and type(v) == "number" then fit[k] = v end
end
local function fitMove() return CFrame.new(fit.x, fit.y, -fit.z) end   -- z: + is forward
local function fitRot()
	return CFrame.Angles(math.rad(fit.pitch), math.rad(fit.yaw), math.rad(fit.roll))
end

-- store model: the avatar holds it through the tool's RightGrip weld, so we nudge that weld.
-- The gun turns around the point where your hand grips it.
local gripBase = setmetatable({}, { __mode = "k" })
local function applyGripFit()
	local char = getChar()
	if not char then return end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local w = hand and hand:FindFirstChild("RightGrip")
	if not (w and w:IsA("JointInstance")) then return end
	local base = gripBase[w]
	if not base then
		base = w.C0
		gripBase[w] = base
	end
	w.C0 = base * fitMove() * fitRot()
end

local function getHandle(tool)
	return tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
end

local function getMuzzle(tool)
	local m = muzzleOf[tool]
	if m and m.Parent then return m end
	return getHandle(tool)
end

-- world position of the flame tip: built-in muzzle, a named part/attachment, or the far end of the handle
local TIP_NAMES = { "muzzle", "nozzle", "flamepoint", "firepoint", "firepos", "tip", "spout" }
local function muzzlePoint(tool)
	local m = muzzleOf[tool]
	if m and m.Parent then return m.Position end
	local h = getHandle(tool)
	if not h then return nil end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("Attachment") or d:IsA("BasePart") then
			local n = string.lower(d.Name)
			local hit = CFG.MUZZLE_NAME ~= "" and d.Name == CFG.MUZZLE_NAME
			if not hit and CFG.MUZZLE_NAME == "" then
				for _, k in ipairs(TIP_NAMES) do
					if string.find(n, k, 1, true) then hit = true break end
				end
			end
			if hit then
				return d:IsA("Attachment") and d.WorldPosition or d.Position
			end
		end
	end
	local sz = h.Size
	local axis, len = Vector3.xAxis, sz.X
	if sz.Y > len then axis, len = Vector3.yAxis, sz.Y end
	if sz.Z > len then axis, len = Vector3.zAxis, sz.Z end
	local v = h.CFrame:VectorToWorldSpace(axis)
	local root = getRoot()
	if root and v:Dot(root.CFrame.LookVector) < 0 then v = -v end
	return h.Position + v * (len / 2)
end

local function ignoreList()
	local list = { fxFolder }
	local c = getChar()
	if c then table.insert(list, c) end
	return list
end

-- world point under the crosshair (mouse on PC, screen centre on phones)
local function aimPoint()
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local vp
	if (shiftLockOn and not menuFree) or (UserInputService.TouchEnabled and not UserInputService.MouseEnabled) then
		vp = cam.ViewportSize / 2
	else
		vp = UserInputService:GetMouseLocation()
	end
	local ray = cam:ViewportPointToRay(vp.X, vp.Y)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = ignoreList()
	local r = Workspace:Raycast(ray.Origin, ray.Direction * 600, rp)
	return r and r.Position or (ray.Origin + ray.Direction * 600)
end

local function getAimDir(origin)
	local p = aimPoint()
	if not p then return nil end
	local d = p - origin
	if d.Magnitude > 0.5 then return d.Unit end
	return nil
end

-- stable frame for the gun: the torso position, but only the yaw of the character root, so walking and
-- running animations (lean, bob) can never shake or tilt the gun
local function stanceRef(torso)
	local root = getRoot()
	local look = (root or torso).CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	return CFrame.new(torso.Position) * CFrame.Angles(0, yaw, 0)
end

-- the gun only tips up/down with the crosshair (yaw is limited) so it doesn't swing around when you look around
local function updateOrient(rig, ref, from)
	local dir = getAimDir(from)
	local target = CFrame.identity
	if dir then
		local l = ref:VectorToObjectSpace(dir)
		local yaw = math.clamp(math.atan2(-l.X, -l.Z), -0.35, 0.35)
		local pitch = math.clamp(math.asin(math.clamp(l.Y, -1, 1)), -1.0, 1.0)
		target = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	end
	rig.orient = rig.orient:Lerp(target, 0.5)
end

local function notifyEmpty()
	if os.clock() - lastEmptyNotify < 2.5 then return end
	lastEmptyNotify = os.clock()
	notify("Out of fuel", "Find a fuel station and hold the prompt to refill.", 4)
	playSoundAt(getRoot(), CFG.SOUNDS.EMPTY, { Volume = 1 })
end

local function useFuel(dt)
	if CFG.LITE then return true end
	fuel = math.max(0, fuel - CFG.FUEL_DRAIN * dt)
	updateFuelUI()
	if fuel <= 0 then
		notifyEmpty()
		return false
	end
	if fuel <= CFG.FUEL_LOW and not lowWarned then
		lowWarned = true
		notify("Fuel low", "Head to a fuel station soon.", 3)
	end
	return true
end

