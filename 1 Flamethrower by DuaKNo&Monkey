local function setEquipped(rig, on)
	if rig.equipped == on then return end
	rig.equipped = on
	if on then
		ropeLayout(rig)
		if not rig.storeMode then rig.gun.Parent = rig.model end
		rig.hoseModel.Parent = rig.model
	else
		rig.firing = false
		if rig.fx then setFiring(rig.fx, false) end
		rig.gun.Parent = nil
		rig.hoseModel.Parent = nil
	end
end

local function finiteCF(cf)
	local p = cf.Position
	return p.X == p.X and p.Y == p.Y and p.Z == p.Z and math.abs(p.X) < 1e5 and math.abs(p.Y) < 1e5 and math.abs(p.Z) < 1e5
end

-- two-bone IK: puts the hand of one R15 arm on a target point
local function solveArm(char, torso, side, target, hintLocal, handRot)
	local upper = char:FindFirstChild(side .. "UpperArm")
	local lower = char:FindFirstChild(side .. "LowerArm")
	local hand = char:FindFirstChild(side .. "Hand")
	if not (upper and lower and hand) then return end
	local shoulder = upper:FindFirstChild(side .. "Shoulder")
	local elbow = lower:FindFirstChild(side .. "Elbow")
	local wrist = hand:FindFirstChild(side .. "Wrist")
	if not (shoulder and elbow) then return end

	local C0s, C1s = shoulder.C0, shoulder.C1
	local S = (torso.CFrame * C0s).Position
	local L1 = (elbow.C0.Position - C1s.Position).Magnitude
	local L2 = wrist and (wrist.C0.Position - elbow.C1.Position).Magnitude or 1.1
	if L1 < 0.1 or L2 < 0.1 then return end

	local toS = S - target
	if toS.Magnitude > 0.01 then
		target = target + toS.Unit * 0.2
	end

	local toT = target - S
	if toT.Magnitude < 0.05 then return end
	local dir = toT.Unit
	local d = math.clamp(toT.Magnitude, 0.2, (L1 + L2) * 0.999)
	local a = (L1 * L1 - L2 * L2 + d * d) / (2 * d)
	local h = math.sqrt(math.max(L1 * L1 - a * a, 0))

	local hint = torso.CFrame:VectorToWorldSpace(hintLocal)
	local pole = hint - dir * hint:Dot(dir)
	if pole.Magnitude < 1e-3 then
		pole = torso.CFrame.RightVector * (side == "Left" and -1 or 1)
	end
	pole = pole.Unit

	local E = S + dir * a + pole * h
	local W = S + dir * d
	local n = dir:Cross(pole).Unit

	local yUp = (S - E).Unit
	local R1 = CFrame.fromMatrix(Vector3.zero, n, yUp)
	local D1 = CFrame.new(S - R1:VectorToWorldSpace(C1s.Position)) * R1
	local T1 = (torso.CFrame * C0s):Inverse() * D1 * C1s
	if not finiteCF(T1) then return end
	shoulder.Transform = T1

	local y2 = (E - W).Unit
	local R2 = CFrame.fromMatrix(Vector3.zero, n, y2)
	local D2 = CFrame.new(E - R2:VectorToWorldSpace(elbow.C1.Position)) * R2
	local T2 = (D1 * elbow.C0):Inverse() * D2 * elbow.C1
	if finiteCF(T2) then elbow.Transform = T2 end
	if wrist then
		wrist.Transform = CFrame.identity
		if handRot then
			-- turn the hand to an exact world rotation (the tool follows the hand)
			local D3 = CFrame.new(W - handRot:VectorToWorldSpace(wrist.C1.Position)) * handRot
			local T3 = (D2 * wrist.C0):Inverse() * D3 * wrist.C1
			if finiteCF(T3) then wrist.Transform = T3 end
		end
	end
end

-- R6 arms are single rigid blocks: just point the arm at the target
local function solveArmR6(char, torso, side, target)
	local arm = char:FindFirstChild(side .. " Arm")
	local shoulder = torso:FindFirstChild(side .. " Shoulder")
	if not (arm and shoulder) then return end
	local C0, C1 = shoulder.C0, shoulder.C1
	local S = (torso.CFrame * C0).Position
	local to = target - S
	if to.Magnitude < 0.05 then return end
	local up = -to.Unit
	local right = torso.CFrame.UpVector:Cross(up)
	if right.Magnitude < 0.05 then
		right = torso.CFrame.RightVector
	else
		right = right.Unit
	end
	-- arm centre sits 0.5 off the joint; swing it toward the middle of the body
	if right:Dot(torso.CFrame.RightVector) > 0 then right = -right end
	local R = CFrame.fromMatrix(Vector3.zero, right, up)
	local D = CFrame.new(S - R:VectorToWorldSpace(C1.Position)) * R
	local T = (torso.CFrame * C0):Inverse() * D * C1
	local p = T.Position
	if p.X == p.X and p.Y == p.Y and p.Z == p.Z then
		shoulder.Transform = T
	end
end

-- keeps the gun hose out of your body (torso seen from above is roughly an ellipse)
local function hoseCollide(tcf)
	return function(pts, n)
		for i = 2, n - 1 do
			local l = tcf:PointToObjectSpace(pts[i])
			if l.Y < 1.0 and l.Y > -1.6 then
				local ex, ez = l.X / 1.3, l.Z / 0.85
				local r = math.sqrt(ex * ex + ez * ez)
				if r < 1 then
					if r < 0.05 then ex, ez, r = 1, 0, 1 end
					pts[i] = tcf:PointToWorldSpace(Vector3.new(ex / r * 1.3, l.Y, ez / r * 0.85))
				end
			end
		end
	end
end

-- puts both hands on the weapon. Runs every frame from several events so the default
-- animations can't pull the arms back down.
local function applyArms(rig)
	local char = getChar()
	local torso = rig.torso
	if not char or not torso.Parent or not rig.equipped then return end

	if rig.storeMode then
		-- right arm: straight out from the shoulder in a fixed stance, the tool follows the hand
		if CFG.HOLD_AT_SHOULDER then
			local ref = stanceRef(torso)
			local aim = ref * rig.orient
			local rsh
			if rig.r15 then
				local up = char:FindFirstChild("RightUpperArm")
				rsh = up and up:FindFirstChild("RightShoulder")
			else
				rsh = torso:FindFirstChild("Right Shoulder")
			end
			if rsh then
				local S = (ref * CFrame.new(rsh.C0.Position)).Position
				local fwd = aim.LookVector
				if rig.r15 then
					local handRot = (aim * CFrame.Angles(math.rad(90), 0, 0)).Rotation
					solveArm(char, torso, "Right", S + fwd * 1.75, Vector3.new(0.5, -1, 0.2), handRot)
				else
					solveArmR6(char, torso, "Right", S + fwd * 2)
				end
			end
		end
		-- the left hand grabs the front half
		if not (CFG.TWO_HANDS and rig.tool) then return end
		local h = rig.handle
		local tip = muzzlePoint(rig.tool)
		if not h or not h.Parent or not tip then return end
		local sh
		if rig.r15 then
			local up = char:FindFirstChild("LeftUpperArm")
			sh = up and up:FindFirstChild("LeftShoulder")
		else
			sh = torso:FindFirstChild("Left Shoulder")
		end
		if not sh then return end
		local shoulderPos = (torso.CFrame * sh.C0).Position
		local reach = rig.r15 and 1.85 or 1.45
		local from = h.Position
		local target = from:Lerp(tip, 0.2)
		for t = 0.8, 0.2, -0.1 do
			local p = from:Lerp(tip, t)
			if (p - shoulderPos).Magnitude <= reach then
				target = p
				break
			end
		end
		target -= torso.CFrame.UpVector * 0.2
		if rig.r15 then
			solveArm(char, torso, "Left", target, Vector3.new(-0.5, -1, 0.2))
		else
			solveArmR6(char, torso, "Left", target)
		end
		return
	end

	local gunCF = stanceRef(torso) * fitMove() * PIVOT * rig.orient * fitRot() * CFrame.new(0, 0, rig.r15 and -1.5 or -1.2)
	local rGrip = (gunCF * CFrame.new(0, -0.7, 0.6)).Position
	local lGrip = (gunCF * CFrame.new(0, -0.5, -0.4)).Position
	if rig.r15 then
		solveArm(char, torso, "Right", rGrip, Vector3.new(0.5, -1, 0.2))
		solveArm(char, torso, "Left", lGrip, Vector3.new(-0.5, -1, 0.2))
	else
		solveArmR6(char, torso, "Right", rGrip)
		solveArmR6(char, torso, "Left", lGrip)
	end
end

local function updateRig(rig)
	local char = getChar()
	if not char or not rig.model.Parent or not rig.equipped then return end
	local torso = rig.torso
	if not torso.Parent then return end

	if rig.storeMode then
		-- store model is held by its own Handle/Grip; we only drive the hose from it to the tank
		applyGripFit()
		do
			local sref = stanceRef(torso)
			updateOrient(rig, sref, (sref * CFrame.new(0.5, 0.6, 0)).Position)
		end
		local h = rig.handle
		if not h or not h.Parent then return end
		do
			local A = (h.CFrame * CFrame.new(0, -0.2, 0)).Position
			local B = (rig.root.CFrame * CFrame.new(0.45, -0.1, -0.25)).Position
			ropeStep(rig.rope, A, B, rig.hoseLen, hoseCollide(torso.CFrame))
			ropeRender(rig.rope, rig.segs, 0.1)
			rig.ends[1].CFrame = CFrame.lookAt(A, rig.rope.pts[2]) * ZAX
			rig.ends[2].CFrame = CFrame.lookAt(B, rig.rope.pts[rig.rope.n - 1]) * ZAX
		end

		applyArms(rig)
		return
	end

	local tcf = stanceRef(torso)
	local pivotCF = tcf * fitMove() * PIVOT
	updateOrient(rig, tcf, pivotCF.Position)
	local gunCF = pivotCF * rig.orient * fitRot() * CFrame.new(0, 0, rig.r15 and -1.5 or -1.2)
	rig.body.CFrame = gunCF

	-- flame leaves the muzzle toward the crosshair
	local mpos = (gunCF * CFrame.new(0, 0, -3.3)).Position
	if rig.firing then
		local fd = getAimDir(mpos) or gunCF.LookVector
		rig.fx.att.WorldCFrame = CFrame.lookAt(mpos, mpos + fd)
		rig.glow.Transparency = 0.1 + math.random() * 0.15
	else
		rig.glow.Transparency = 0.9
	end

	-- hose: right side of the handguard, round your right side, into the tank
	do
		local A = (gunCF * CFrame.new(0.27, -0.08, -0.82)).Position
		local B = (rig.root.CFrame * CFrame.new(0.45, -0.1, -0.25)).Position
		ropeStep(rig.rope, A, B, rig.hoseLen, hoseCollide(tcf))
		ropeRender(rig.rope, rig.segs, 0.1)
		rig.ends[1].CFrame = CFrame.lookAt(A, rig.rope.pts[2]) * ZAX
		rig.ends[2].CFrame = CFrame.lookAt(B, rig.rope.pts[rig.rope.n - 1]) * ZAX
	end

	applyArms(rig)

	rig.light.Brightness = (rig.firing and 1.6 or 1) + math.random() * 0.6
end

------------------------------------------------------------------ FIRING
local lastGroundFire = 0
local function sprayFlame(tool)
	local napalm = CFG.NAPALM
	local char = getChar()
	local origin = muzzlePoint(tool)
	if not origin or not char then return end
	local handle = getHandle(tool)
	local dir = getAimDir(origin) or (handle and handle.CFrame.LookVector) or Vector3.zAxis

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignoreList()

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignoreList()

	-- fire on whatever surface the stream reaches (leaves burning patches and scorch marks)
	local hit = Workspace:Raycast(origin, dir * CFG.RANGE * 0.95, rayParams)
	if hit then
		local m = hit.Instance:FindFirstAncestorOfClass("Model")
		if not (m and m:FindFirstChildOfClass("Humanoid")) then
			local now = os.clock()
			if now - lastGroundFire > (napalm and 0.18 or 0.3) then
				lastGroundFire = now
				local pos = hit.Position
				if hit.Normal.Y > 0.7 then
					pos += Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 1.6
				end
				groundFire(pos, hit.Normal, napalm)
			end
		end
	end

	local half = CFG.RANGE / 2
	local parts = Workspace:GetPartBoundsInRadius(origin + dir * half, half, params)
	local done = {}

	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and not done[model] and not Players:GetPlayerFromCharacter(model) then
			local hum = model:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local to = part.Position - origin
				if to.Magnitude > 0.1 then
					local angle = math.deg(math.acos(math.clamp(dir:Dot(to.Unit), -1, 1)))
					if angle <= CFG.CONE_ANGLE then
						local h = Workspace:Raycast(origin, to, rayParams)
						if not h or h.Instance:IsDescendantOf(model) then
							done[model] = true
							ignite(model, hum, napalm)
							-- napalm sticks: a burning puddle under whoever it hits
							if napalm then
								local t = os.clock()
								if t - CFG.lastDrop > 0.35 then
									CFG.lastDrop = t
									local rp = model:FindFirstChild("HumanoidRootPart")
									if rp then
										local g, n = groundAt(rp.Position, { fxFolder, model, char })
										groundFire(g + n * 0.03, n, true)
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

------------------------------------------------------------------ BEGGING SCENE
-- Hold the crosshair on an NPC: he freezes, turns to you, drops to his knees and begs (your emote),
-- the screen goes cinematic, and you decide: shoot, or look away and he runs off.
if not CFG.LITE then
	local B = CFG.BEG or {}
	if B then
		local TweenService = game:GetService("TweenService")
		local Lighting = game:GetService("Lighting")
		local SoundService = game:GetService("SoundService")

		local BAR = 0.115
		local RANGE = B.RANGE or 35
		local AIM_TIME = B.AIM_TIME or 0.35
		local MERCY = B.MERCY_TIME or 1.1
		local LINES = B.LINES or { "Please don't!" }
		local SPARED = B.SPARED_LINES or { "Thank you!" }

		local scene = nil        -- the NPC who is begging right now
		local aimModel, aimTime = nil, 0
		local cooldown = setmetatable({}, { __mode = "k" })
		local poseLock = setmetatable({}, { __mode = "k" })   -- NPCs whose pose is being driven by the begging scene
		CFG.isPosed = function(m) return poseLock[m] or (scene and scene.model == m) end
		local walk = setmetatable({}, { __mode = "k" })
		local cinemaOn = false
		local baseFov = nil
		local outAt = 0
		local shakeT = 0

		local function tw(obj, t, props, style)
			TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), props):Play()
		end

		---------------------------------------------------------------- cinematic overlay
		local cg = Instance.new("ScreenGui")
		cg.Name = "BegCinema"
		cg.IgnoreGuiInset = true
		cg.ResetOnSpawn = false
		cg.DisplayOrder = 50
		cg.Parent = player:WaitForChild("PlayerGui")

		local vig = Instance.new("CanvasGroup")
		vig.Size = UDim2.fromScale(1, 1)
		vig.BackgroundTransparency = 1
		vig.GroupTransparency = 1
		vig.Parent = cg
		local function edge(size, pos, anchor, rot)
			local f = Instance.new("Frame")
			f.BackgroundColor3 = Color3.new(0, 0, 0)
			f.BorderSizePixel = 0
			f.Size, f.Position, f.AnchorPoint = size, pos, anchor
			local g = Instance.new("UIGradient")
			g.Rotation = rot
			g.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.62), NumberSequenceKeypoint.new(1, 1),
			})
			g.Parent = f
			f.Parent = vig
		end
		edge(UDim2.fromScale(0.3, 1), UDim2.fromScale(0, 0), Vector2.new(0, 0), 0)
		edge(UDim2.fromScale(0.3, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180)
		edge(UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0), Vector2.new(0, 0), 90)
		edge(UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 1), Vector2.new(0, 1), -90)

		local function bar(anchorY)
			local f = Instance.new("Frame")
			f.BackgroundColor3 = Color3.new(0, 0, 0)
			f.BorderSizePixel = 0
			f.AnchorPoint = Vector2.new(0, anchorY)
			f.Position = UDim2.fromScale(0, anchorY)
			f.Size = UDim2.fromScale(1, 0)
			f.Parent = cg
			return f
		end
		local topBar, botBar = bar(0), bar(1)

		local sub = Instance.new("TextLabel")
		sub.BackgroundTransparency = 1
		sub.Size = UDim2.fromScale(1, 1)
		sub.Font = Enum.Font.Garamond
		sub.TextScaled = true
		sub.TextColor3 = Color3.fromRGB(240, 232, 220)
		sub.TextStrokeColor3 = Color3.new(0, 0, 0)
		sub.TextTransparency = 1
		sub.TextStrokeTransparency = 1
		sub.Text = ""
		local sp = Instance.new("UIPadding")
		sp.PaddingTop, sp.PaddingBottom = UDim.new(0.18, 0), UDim.new(0.18, 0)
		sp.Parent = sub
		sub.Parent = botBar

		local flash = Instance.new("Frame")
		flash.Size = UDim2.fromScale(1, 1)
		flash.BackgroundColor3 = Color3.fromRGB(255, 190, 110)
		flash.BackgroundTransparency = 1
		flash.BorderSizePixel = 0
		flash.Parent = cg

		for _, n in ipairs({ "BegGrade", "BegFocus" }) do
			local old = Lighting:FindFirstChild(n)
			if old then old:Destroy() end
		end
		local grade = Instance.new("ColorCorrectionEffect")
		grade.Name = "BegGrade"
		grade.Enabled = false
		grade.Parent = Lighting
		local dof = Instance.new("DepthOfFieldEffect")
		dof.Name = "BegFocus"
		dof.Enabled = false
		dof.InFocusRadius = 12
		dof.NearIntensity, dof.FarIntensity = 0, 0
		dof.Parent = Lighting

		local subTok = 0
		local function subtitle(text)
			subTok += 1
			local tok = subTok
			if B.CINEMATIC == false then return end
			if not text then
				tw(sub, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 })
				return
			end
			sub.Text = "\"" .. text .. "\""
			sub.TextTransparency, sub.TextStrokeTransparency = 1, 1
			tw(sub, 0.25, { TextTransparency = 0, TextStrokeTransparency = 0.6 })
			task.delay(1.7, function()
				if tok == subTok then tw(sub, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 }) end
			end)
		end

		local function cinemaIn()
			if B.CINEMATIC == false or cinemaOn then return end
			cinemaOn = true
			tw(topBar, 0.9, { Size = UDim2.fromScale(1, BAR) })
			tw(botBar, 0.9, { Size = UDim2.fromScale(1, BAR) })
			tw(vig, 1.2, { GroupTransparency = 0 })
			grade.Enabled = true
			tw(grade, 1.4, {
				Saturation = -0.15, Contrast = 0.08, Brightness = 0,
				TintColor = Color3.fromRGB(255, 243, 230),
			})
			dof.Enabled = true
			tw(dof, 1.4, { FarIntensity = 0.35, NearIntensity = 0 })
			local cam = Workspace.CurrentCamera
			if cam then
				if not baseFov then baseFov = cam.FieldOfView end
				tw(cam, 7, { FieldOfView = baseFov - 16 }, Enum.EasingStyle.Quad)
			end
		end

		local function cinemaOut()
			if not cinemaOn then return end
			cinemaOn = false
			subtitle(nil)
			tw(topBar, 0.4, { Size = UDim2.fromScale(1, 0) })
			tw(botBar, 0.4, { Size = UDim2.fromScale(1, 0) })
			tw(vig, 0.4, { GroupTransparency = 1 })
			tw(grade, 0.4, {
				Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.new(1, 1, 1),
			})
			tw(dof, 0.4, { FarIntensity = 0, NearIntensity = 0 })
			local cam = Workspace.CurrentCamera
			if cam and baseFov then tw(cam, 0.4, { FieldOfView = baseFov }) end
			outAt = os.clock()
			task.delay(1, function()
				if cinemaOn then return end
				grade.Enabled = false
				dof.Enabled = false
				local c = Workspace.CurrentCamera
				if c and baseFov then c.FieldOfView = baseFov end
				baseFov = nil
			end)
		end

		---------------------------------------------------------------- kneeling pose (used if the emote can't load)
		local function joints(model)
			local j = {}
			local function f(name) j[name] = model:FindFirstChild(name, true) end
			for _, n in ipairs({ "RootJoint", "Waist", "Neck", "RightHip", "LeftHip", "RightKnee", "LeftKnee", "RightShoulder", "LeftShoulder", "RightElbow", "LeftElbow", "Right Shoulder", "Left Shoulder", "Right Hip", "Left Hip" }) do
				f(n)
			end
			return j
		end
		-- every pose we set is remembered and pushed again right before each frame is drawn, so the
		-- avatar's own animator can never wipe it out (this was why he stayed in a T-pose)
		local lastT = setmetatable({}, { __mode = "k" })
		local function setT(j, name, cf)
			local m = j[name]
			if m and m:IsA("Motor6D") then
				m.Transform = cf
				lastT[m] = cf
			end
		end
		local function resetPose(j)
			for name, m in pairs(j) do
				if m and m.Parent and m:IsA("Motor6D") then
					m.Transform = CFrame.identity
					lastT[m] = nil
				end
			end
		end
		local function reapplyPoses()
			for m, cf in pairs(lastT) do
				if m.Parent then m.Transform = cf else lastT[m] = nil end
			end
		end
		RunService.RenderStepped:Connect(reapplyPoses)
		RunService.Stepped:Connect(reapplyPoses)
		pcall(function() RunService.PreAnimation:Connect(reapplyPoses) end)
		-- built-in begging animation, copied from your "Praying" emote video: hands clasped at the chest,
		-- elbows tucked, hunched, head tilted up, rocking and trembling. Optional KNEEL drops him to his knees too (R15 avatars)
		local function kneelPose(s, t, force)
			if not (s.r15 or s.r6) then return end
			local e = force or math.clamp(t / 0.7, 0, 1)
			e = e * e * (3 - 2 * e)
			local rock = math.sin(t * 2.2)
			local bob = math.sin(t * 4.4)
			local tr = math.sin(t * 27) * 0.012 * e
			local sob = math.sin(t * 19) * 0.012 * e
			local j = s.joints
			if s.r6 then
				-- R6 has no elbows: both arms come up in front, hands pressed together, pleading
				local sw = (1.2 + 0.12 * bob) * e
				setT(j, "Right Shoulder", CFrame.Angles(0, 0, sw + tr) * CFrame.Angles(0.33 * e, 0, 0))
				setT(j, "Left Shoulder", CFrame.Angles(0, 0, -(sw - tr)) * CFrame.Angles(0.33 * e, 0, 0))
				setT(j, "Neck", CFrame.Angles(-(0.16 + 0.04 * rock) * e, math.sin(t * 1.7) * 0.1 * e, 0))
				setT(j, "RootJoint", CFrame.Angles(-(0.06 + 0.03 * rock) * e + sob, 0, 0))
				setT(j, "Right Hip", CFrame.Angles(0, 0, 0.05 * e))
				setT(j, "Left Hip", CFrame.Angles(0, 0, -0.05 * e))
				return
			end
			if B.KNEEL == true then
				setT(j, "RootJoint", CFrame.new(0, -(s.drop or 0.95) * e, 0))
				setT(j, "RightHip", CFrame.Angles(0.1 * e, 0, 0))
				setT(j, "LeftHip", CFrame.Angles(0.1 * e, 0, 0))
				setT(j, "RightKnee", CFrame.Angles(-1.5 * e, 0, 0))
				setT(j, "LeftKnee", CFrame.Angles(-1.5 * e, 0, 0))
			else
				-- standing: knees a little bent, feet together, like the emote
				setT(j, "RightHip", CFrame.Angles(0.08 * e, 0, 0.05 * e))
				setT(j, "LeftHip", CFrame.Angles(0.08 * e, 0, -0.05 * e))
				setT(j, "RightKnee", CFrame.Angles(-0.16 * e, 0, 0))
				setT(j, "LeftKnee", CFrame.Angles(-0.16 * e, 0, 0))
			end
			setT(j, "Waist", CFrame.Angles((-0.14 - 0.05 * rock) * e + sob, 0, 0))
			setT(j, "Neck", CFrame.Angles((0.14 + 0.04 * rock) * e, 0, math.sin(t * 1.7) * 0.1 * e))
			-- upper arms down and forward, tucked in; forearms folded up across the chest so the hands meet
			setT(j, "RightShoulder", CFrame.Angles(0.38 * e + tr, 0, -0.3 * e))
			setT(j, "LeftShoulder", CFrame.Angles(0.38 * e - tr, 0, 0.3 * e))
			setT(j, "RightElbow", CFrame.Angles((1.75 + 0.1 * bob) * e + tr, -0.35 * e, 0))
			setT(j, "LeftElbow", CFrame.Angles((1.75 + 0.1 * bob) * e - tr, 0.35 * e, 0))
		end

		---------------------------------------------------------------- scene control
		local function targetUnder()
			local cam = Workspace.CurrentCamera
			if not cam then return nil end
			local vp
			if (shiftLockOn and not menuFree) or (UserInputService.TouchEnabled and not UserInputService.MouseEnabled) then
				vp = cam.ViewportSize / 2
			else
				vp = UserInputService:GetMouseLocation()
			end
			local ray = cam:ViewportPointToRay(vp.X, vp.Y)
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			rp.FilterDescendantsInstances = ignoreList()
			local r = Workspace:Spherecast(ray.Origin, 1.1, ray.Direction * (RANGE + 30), rp)
			if not r then return nil end
			local m = r.Instance:FindFirstAncestorOfClass("Model")
			if not m or Players:GetPlayerFromCharacter(m) then return nil end
			local hum = m:FindFirstChildOfClass("Humanoid")
			local root = m:FindFirstChild("HumanoidRootPart")
			if not hum or not root or hum.Health <= 0 or burning[m] or ragdollData[m] then return nil end
			local mine = getRoot()
			if not mine or (mine.Position - root.Position).Magnitude > RANGE then return nil end
			return m, hum, root
		end

		local function release(s, why)
			pcall(function() if s.track then s.track:Stop(0.25) end end)
			if why == "spared" and not s.track then
				poseLock[s.model] = true
				task.spawn(function()
					local t0 = os.clock()
					while s.model.Parent do
						local k = (os.clock() - t0) / 0.5
						if k >= 1 then break end
						kneelPose(s, 99, 1 - k)
						RunService.Heartbeat:Wait()
					end
					resetPose(s.joints)
					poseLock[s.model] = nil
				end)
			else
				resetPose(s.joints)
			end
			if s.hum.Parent then
				s.hum.AutoRotate = true
				if why ~= "fired" then s.hum.WalkSpeed = s.oldSpeed end
			end
			if s.tension then
				local t = s.tension
				tw(t, 0.6, { Volume = 0 })
				Debris:AddItem(t, 1)
			end
		end

		-- how far the body has to sink so the knees touch the ground (measured, not guessed)
		local function kneelDrop(model, root)
			local knee = model:FindFirstChild("RightKnee", true)
			local shin = model:FindFirstChild("RightLowerLeg")
			if not (knee and knee:IsA("Motor6D") and knee.Part0 and shin) then return 0.95 end
			local kneeY = (knee.Part0.CFrame * knee.C0).Position.Y
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			local list = ignoreList()
			table.insert(list, model)
			rp.FilterDescendantsInstances = list
			local r = Workspace:Raycast(root.Position, Vector3.new(0, -14, 0), rp)
			local gy = r and r.Position.Y or (root.Position.Y - 3)
			return math.clamp(kneeY - gy - math.min(shin.Size.X, shin.Size.Z) * 0.5, 0.3, 3)
		end

		local function startScene(model, hum, root)
			local animator = hum:FindFirstChildOfClass("Animator")
			if not animator then
				animator = Instance.new("Animator")
				animator.Parent = hum
			end
			local rt = hum.RigType == Enum.HumanoidRigType.R15 and "R15" or "R6"
			print("[Flamethrower] begging scene started on a " .. rt .. " NPC")
			local s = {
				model = model, hum = hum, root = root, start = os.clock(), nextLine = 0, line = 0,
				oldSpeed = hum.WalkSpeed, joints = joints(model), r15 = model:FindFirstChild("UpperTorso") ~= nil, r6 = model:FindFirstChild("UpperTorso") == nil and model:FindFirstChild("Torso") ~= nil, drop = kneelDrop(model, root),
			}
			hum.WalkSpeed = 0
			hum.AutoRotate = false
			hum:Move(Vector3.zero)

			if B.ANIM and tostring(B.ANIM) ~= "" then
				local a = Instance.new("Animation")
				a.AnimationId = "rbxassetid://" .. tostring(B.ANIM)
				local ok, track = pcall(function() return animator:LoadAnimation(a) end)
				if ok and track then
					track.Looped = true
					track.Priority = Enum.AnimationPriority.Action4
					track:Play(0.35)
					s.track = track
				end
			end
			s.tension = playSoundAt(SoundService, CFG.SOUNDS.BEG_TENSION, { Looped = true, Volume = 0.55 })
			scene = s
			cinemaIn()
		end

		local function endScene(why)
			local s = scene
			if not s then return end
			scene = nil
			release(s, why)
			cooldown[s.model] = os.clock() + 1.5
			subtitle(nil)
			cinemaOut()   -- the dark look is only there while you aim at him
			if why == "fired" then
				shakeT = 0.6
				flash.BackgroundTransparency = 0.35
				tw(flash, 0.5, { BackgroundTransparency = 1 })
			elseif why == "spared" then
				say(s.model, SPARED[math.random(1, #SPARED)])
				-- he scrambles away from you
				local mine = getRoot()
				if s.hum.Parent and mine then
					local away = s.root.Position - mine.Position
					away = Vector3.new(away.X, 0, away.Z)
					away = away.Magnitude > 0.1 and away.Unit or Vector3.xAxis
					s.hum.WalkSpeed = 20
					s.hum:MoveTo(s.root.Position + away * 45)
					task.delay(3.5, function()
						if s.hum.Parent and not burning[s.model] then s.hum.WalkSpeed = s.oldSpeed end
					end)
				end
			end
		end

		-- walking / running / burning-panic animation for spawned NPCs (they have no animation scripts, so they would glide)
		RunService.Heartbeat:Connect(function(dt)
			local now = os.clock()
			for _, m in ipairs(spawned) do
				local hum = m.Parent and m:FindFirstChildOfClass("Humanoid")
				local root = m:FindFirstChild("HumanoidRootPart")
				if hum and root and (m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso")) and hum.Health > 0 and not ragdollData[m]
					and not poseLock[m] and not CFG.animActive[m] and not (scene and scene.model == m) then
					local w = walk[m]
					if not w then
						w = { phase = 0, amp = 0, joints = joints(m), r6 = m:FindFirstChild("UpperTorso") == nil }
						walk[m] = w
					end
					local v = root.AssemblyLinearVelocity
					local sp = Vector3.new(v.X, 0, v.Z).Magnitude
					local moving = sp > 1.5
					w.amp += ((moving and 1 or 0) - w.amp) * math.min(dt * 10, 1)
					w.phase += dt * math.clamp(sp, 0, 24) * 0.55
					if w.amp < 0.02 and not burning[m] then
						if not w.idle then
							resetPose(w.joints)
							w.idle = true
						end
					else
						w.idle = false
						local a = w.amp * math.clamp(0.35 + sp / 30, 0.35, 0.95)
						local ph = w.phase
						local sR, sL = math.sin(ph), math.sin(ph + math.pi)
						local j = w.joints
						if w.r6 then
							-- R6: legs and arms swing about the joint's own Z axis (right side = forward, left side = mirrored)
							setT(j, "Right Hip", CFrame.Angles(0, 0, sR * a * 1.1))
							setT(j, "Left Hip", CFrame.Angles(0, 0, -sL * a * 1.1))
							if burning[m] then
								local fl = math.sin(now * 14) * 0.35
								setT(j, "Right Shoulder", CFrame.Angles(0, 0, 2.9 + fl) * CFrame.Angles(0.3, 0, 0))
								setT(j, "Left Shoulder", CFrame.Angles(0, 0, -(2.9 - fl)) * CFrame.Angles(0.3, 0, 0))
							else
								setT(j, "Right Shoulder", CFrame.Angles(0, 0, -sR * a * 0.9))
								setT(j, "Left Shoulder", CFrame.Angles(0, 0, sL * a * 0.9))
							end
							setT(j, "RootJoint", CFrame.Angles(-0.08 * a, 0, 0))
						else
						setT(j, "RightHip", CFrame.Angles(sR * a, 0, 0))
						setT(j, "LeftHip", CFrame.Angles(sL * a, 0, 0))
						setT(j, "RightKnee", CFrame.Angles(-math.max(0, math.cos(ph)) * a * 1.3, 0, 0))
						setT(j, "LeftKnee", CFrame.Angles(-math.max(0, math.cos(ph + math.pi)) * a * 1.3, 0, 0))
						setT(j, "Waist", CFrame.Angles(-0.1 * a, 0, 0))
						if burning[m] then
							-- on fire: arms up in the air, flailing
							local fl = math.sin(now * 14 + (m:GetFullName():len() % 5)) * 0.35
							setT(j, "RightShoulder", CFrame.Angles(2.7 + fl, 0, -0.45))
							setT(j, "LeftShoulder", CFrame.Angles(2.7 - fl, 0, 0.45))
							setT(j, "RightElbow", CFrame.Angles(0.4 + fl * 0.5, 0, 0))
							setT(j, "LeftElbow", CFrame.Angles(0.4 - fl * 0.5, 0, 0))
						else
							setT(j, "RightShoulder", CFrame.Angles(-sR * a * 0.9, 0, 0))
							setT(j, "LeftShoulder", CFrame.Angles(-sL * a * 0.9, 0, 0))
							setT(j, "RightElbow", CFrame.Angles(0.25 + a * 0.5, 0, 0))
							setT(j, "LeftElbow", CFrame.Angles(0.25 + a * 0.5, 0, 0))
						end
						end -- r15 / r6
					end
				end
			end
		end)

		RunService.Heartbeat:Connect(function(dt)
			local now = os.clock()
			local out = crosshairWanted > 0 and B.ENABLED ~= false

			-- aim detection
			local m, hum, root
			if out and not firingNow then
				m, hum, root = targetUnder()
			end
			if m and m == aimModel then
				aimTime += dt
			else
				aimModel, aimTime = m, 0
			end

			if scene then
				local s = scene
				if not out then
					endScene("cancel")
				elseif burning[s.model] then
					endScene("fired")
				elseif not (s.model.Parent and s.hum.Parent and s.hum.Health > 0 and s.root.Parent) then
					endScene("cancel")
				else
					-- lost aim? mercy timer
					if aimModel == s.model then
						s.lost = nil
					else
						s.lost = s.lost or now
						if now - s.lost > MERCY and not firingNow then
							endScene("spared")
						end
					end
				end
			end

			if scene then
				local s = scene
				-- turn to face you
				local mine = getRoot()
				if mine then
					local p = s.root.Position
					local want = CFrame.lookAt(p, Vector3.new(mine.Position.X, p.Y, mine.Position.Z))
					s.root.CFrame = s.root.CFrame:Lerp(want, math.min(dt * 8, 1))
					s.hum:Move(Vector3.zero)
					local cam = Workspace.CurrentCamera
					if cam and dof.Enabled then
						dof.FocusDistance = math.max((cam.CFrame.Position - p).Magnitude, 1)
					end
				end
				-- no emote? use the built-in kneel
				local t = now - s.start
				if s.track and t > 0.8 and s.track.Length <= 0 then s.track = nil end
				if not s.track then kneelPose(s, t) end

				if now >= s.nextLine then
					s.nextLine = now + 1.9
					s.line += 1
					local line = LINES[((s.line - 1) % #LINES) + 1]
					say(s.model, line)
					subtitle(line)
				end
			elseif not firingNow and m and aimTime >= AIM_TIME and now >= (cooldown[m] or 0) then
				startScene(m, hum, root)
			end

			-- the dark look is ONLY on while the crosshair is on him (a short grace so it doesn't flicker)
			local onHim = scene ~= nil and aimModel == scene.model
			if scene then
				if onHim or firingNow then scene.offAim = nil else scene.offAim = scene.offAim or now end
			end
			local wantLook = B.CINEMATIC ~= false and scene ~= nil and (scene.offAim == nil or now - scene.offAim < 0.25)
			if cinemaOn and not wantLook then cinemaOut() end
			if wantLook and not cinemaOn then cinemaIn() end
			-- safety net: nothing may stay dark once the scene is over
			if not cinemaOn and (grade.Enabled or dof.Enabled) and now - outAt > 1.2 then
				grade.Enabled, dof.Enabled = false, false
				vig.GroupTransparency = 1
				topBar.Size, botBar.Size = UDim2.fromScale(1, 0), UDim2.fromScale(1, 0)
			end

			-- scene replaced by someone else you're aiming at
			if scene and m and m ~= scene.model and aimTime >= AIM_TIME and now >= (cooldown[m] or 0) then
				endScene("cancel")
			end
		end)

		-- slow handheld sway while the scene runs, plus a kick when the fire starts
		RunService:BindToRenderStep("FlamethrowerCinema", Enum.RenderPriority.Camera.Value + 2, function(dt)
			local cam = Workspace.CurrentCamera
			if not cam then return end
			local t = os.clock()
			local a = scene and 0.0025 or 0
			local sh = 0
			if shakeT > 0 then
				shakeT = math.max(0, shakeT - dt)
				sh = shakeT * 0.05
			end
			if a + sh > 0 then
				cam.CFrame = cam.CFrame * CFrame.Angles(
					math.sin(t * 1.3) * a + (math.random() - 0.5) * sh,
					math.cos(t * 1.7) * a + (math.random() - 0.5) * sh,
					0
				)
			end
		end)
	end
end

------------------------------------------------------------------ OVERHEAT
-- fire non-stop for TIME seconds and the tank blows up in your face. Letting go cools it down again.
if not CFG.LITE then
	local H = CFG.HEAT or {}
	local TweenService = game:GetService("TweenService")
	local heat = 0           -- 0..1
	local lastChar = nil
	local warned = false
	local exploded = false

	local gui = Instance.new("ScreenGui")
	gui.Name = "FlamethrowerHeatHUD"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = UDim2.new(0.5, 0, 1, -154)
	frame.Size = UDim2.fromOffset(240, 38)
	frame.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
	frame.BackgroundTransparency = 0.2
	frame.BorderSizePixel = 1
	frame.BorderColor3 = Color3.fromRGB(80, 80, 80)
	frame.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 18)
	title.Position = UDim2.fromOffset(0, 3)
	title.BackgroundTransparency = 1
	title.TextColor3 = Color3.fromRGB(230, 230, 230)
	title.Font = Enum.Font.Code
	title.TextSize = 13
	title.Text = "HEAT  0%"
	title.Parent = frame

	local back = Instance.new("Frame")
	back.Size = UDim2.new(1, -20, 0, 8)
	back.Position = UDim2.fromOffset(10, 24)
	back.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
	back.BorderSizePixel = 0
	back.Parent = frame
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Color3.fromRGB(90, 170, 255)
	fill.Parent = back

	local white = Instance.new("ScreenGui")
	white.Name = "FlamethrowerBlast"
	white.ResetOnSpawn = false
	white.IgnoreGuiInset = true
	white.DisplayOrder = 100
	white.Parent = player:WaitForChild("PlayerGui")
	local wf = Instance.new("Frame")
	wf.Size = UDim2.fromScale(1, 1)
	wf.BackgroundColor3 = Color3.fromRGB(255, 235, 200)
	wf.BackgroundTransparency = 1
	wf.BorderSizePixel = 0
	wf.Parent = white

	local function explode()
		exploded = true
		heat = 0
		local char, root = getChar(), getRoot()
		if not root then return end
		local pos = root.Position
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		-- blast look (local only: no pressure, no joint damage)
		local ex = Instance.new("Explosion")
		ex.Position = pos
		ex.BlastRadius = 12
		ex.BlastPressure = 0
		ex.DestroyJointRadiusPercent = 0
		ex.ExplosionType = Enum.ExplosionType.NoCraters
		ex.Parent = Workspace

		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Anchored, ball.CanCollide, ball.CanQuery, ball.CanTouch = true, false, false, false
		ball.Material = Enum.Material.Neon
		ball.Color = Color3.fromRGB(255, 150, 40)
		ball.Size = Vector3.one * 3
		ball.Position = pos
		ball.Parent = fxFolder or Workspace
		TweenService:Create(ball, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.one * 26, Transparency = 1,
		}):Play()
		Debris:AddItem(ball, 1)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 160, 60)
		light.Range = 40
		light.Brightness = 8
		light.Parent = ball
		local att = Instance.new("Attachment")
		att.WorldPosition = pos
		att.Parent = Workspace.Terrain
		local sm = makeSmokeEmitter(att, 40, 5)
		sm.Lifetime = NumberRange.new(2.5, 4.5)
		task.delay(0.5, function() sm.Enabled = false end)
		Debris:AddItem(att, 6)

		playSoundAt(root, CFG.SOUNDS.EXPLODE ~= "" and CFG.SOUNDS.EXPLODE or "rbxasset://sounds/impact_explosion_03.mp3", { Volume = 2 })

		wf.BackgroundTransparency = 0
		TweenService:Create(wf, TweenInfo.new(1.6, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 }):Play()

		-- anyone standing close burns too
		local ps = OverlapParams.new()
		ps.FilterType = Enum.RaycastFilterType.Exclude
		ps.FilterDescendantsInstances = { fxFolder, char }
		local seen = {}
		for _, part in ipairs(Workspace:GetPartBoundsInRadius(pos, 16, ps)) do
			local m = part:FindFirstAncestorOfClass("Model")
			if m and not seen[m] and not Players:GetPlayerFromCharacter(m) then
				local h = m:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 then
					seen[m] = true
					ignite(m, h)
				end
			end
		end

		notify("OVERHEATED", "The flamethrower exploded!", 4)
		-- you go with it
		if hum then
			hum.Health = 0
			if char then
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BasePart") then
						p.AssemblyLinearVelocity = (p.Position - pos).Unit * 55 + Vector3.new(0, 45, 0)
					end
				end
			end
		end
	end

	RunService.Heartbeat:Connect(function(dt)
		local char = getChar()
		if char ~= lastChar then
			lastChar = char
			heat, warned, exploded = 0, false, false
		end
		local on = H.ENABLED ~= false
		local out = crosshairWanted > 0
		gui.Enabled = on and out and not exploded
		if not on then
			heat = 0
			return
		end

		local time = math.max(H.TIME or 8, 1)
		if firingNow then
			heat = math.min(1, heat + dt / time)
		else
			heat = math.max(0, heat - dt * (H.COOL or 0.18))
		end
		if heat < 0.5 then warned = false end

		-- bar + warning text
		local warn = H.WARN or 0.65
		fill.Size = UDim2.fromScale(heat, 1)
		local pct = math.floor(heat * 100 + 0.5)
		if heat >= warn then
			local blink = math.sin(os.clock() * (10 + heat * 14)) > 0
			title.Text = string.format("HEAT! HEAT!  %d%%", pct)
			title.TextColor3 = blink and Color3.fromRGB(255, 70, 50) or Color3.fromRGB(255, 255, 255)
			frame.BorderColor3 = blink and Color3.fromRGB(255, 70, 50) or Color3.fromRGB(80, 80, 80)
			fill.BackgroundColor3 = Color3.fromRGB(255, 50, 30)
			if not warned and heat >= 0.85 then
				warned = true
				notify("OVERHEATING!", "Let go of the trigger or it will blow up!", 3)
				playSoundAt(getRoot(), CFG.SOUNDS.HEAT_WARN, { Volume = 1 })
			end
		else
			title.Text = string.format("HEAT  %d%%", pct)
			title.TextColor3 = Color3.fromRGB(230, 230, 230)
			frame.BorderColor3 = Color3.fromRGB(80, 80, 80)
			fill.BackgroundColor3 = heat < 0.35 and Color3.fromRGB(90, 170, 255) or Color3.fromRGB(255, 175, 40)
		end

		if heat >= 1 and not exploded and firingNow then
			explode()
		end
	end)
end

local hooked = {}
local function hookTool(tool)
	if hooked[tool] or not tool:IsA("Tool") then return end
	if not string.find(string.lower(tool.Name), CFG.TOOL_KEYWORD) then return end
	hooked[tool] = true

	-- store tool: add the back tank + hose so the fuel nozzle has something to plug into
	if (CFG.BACK_TANK or CFG.LITE) and not rigOf[tool] then
		local char = getChar()
		local r15 = true
		local torso = char and char:FindFirstChild("UpperTorso")
		if char and not torso then
			r15 = false
			torso = char:FindFirstChild("Torso")
		end
		if torso and getHandle(tool) then
			local rig = buildRig(char, torso, r15)
			rig.storeMode = true
			rig.tool = tool
			rig.handle = getHandle(tool)
			rigOf[tool] = rig
			activeRig = rig
			updateFuelUI()
		end
	end

	local conns = {}
	local function bind(sig, fn)
		table.insert(conns, sig:Connect(function(...)
			if CFG.FT.stopped then return end
			return fn(...)
		end))
	end

	local holding = false
	local loopSound
	local fx
	local startedAt, pressId, loopId = 0, 0, 0
	local rsConn
	local chOn = false
	local function setOut(v) -- this tool is equipped: crosshair + (optionally) shift lock
		if v == chOn then return end
		chOn = v
		crosshairWanted += v and 1 or -1
		CFG.NET.setActive(crosshairWanted > 0)
		CFG.setMenuVisible(crosshairWanted > 0)
		if CFG.AUTO_SHIFTLOCK then setShiftLock(v) end
	end

	local function getFx()
		if fx then return fx end
		fx = fxOf[tool]
		if not fx then
			local m = getMuzzle(tool)
			if m then
				fx = buildFlameFX(m)
				fxOf[tool] = fx
				fx.store = true
			end
		end
		return fx
	end

	local function stop()
		holding = false
		firingNow = false
		if fx then setFiring(fx, false) end
		if rsConn then
			rsConn:Disconnect()
			rsConn = nil
		end
		local rig = rigOf[tool]
		if rig then rig.firing = false end
		if loopSound then
			loopSound:Stop()
			loopSound:Destroy()
			loopSound = nil
		end
	end

	local function start()
		if holding then
			pressId += 1 -- cancels a pending delayed stop
			return
		end
		if tool.Parent ~= getChar() or refueling then return end
		if fuel <= 0 then
			notifyEmpty()
			return
		end
		pressId += 1
		loopId += 1
		local myLoop = loopId
		holding = true
		firingNow = true
		startedAt = os.clock()
		local f = getFx()
		if f then setFiring(f, true) end
		local rig = rigOf[tool]
		if rig then rig.firing = true end
		if f and f.store then
			-- store model: keep the flame pointed from its tip toward the crosshair
			rsConn = RunService.RenderStepped:Connect(function()
				local o = muzzlePoint(tool)
				if not o then return end
				local d = getAimDir(o)
				if d then f.att.WorldCFrame = CFrame.lookAt(o, o + d) end
			end)
		end
		playSoundAt(getMuzzle(tool), CFG.SOUNDS.FLAME_START, { Volume = 0.9 })
		loopSound = playSoundAt(getMuzzle(tool), CFG.SOUNDS.FLAME_LOOP, { Looped = true, Volume = 0.8 })

		task.spawn(function()
			while holding and loopId == myLoop and tool.Parent == getChar() and not refueling do
				sprayFlame(tool)
				if not useFuel(CFG.TICK) then break end
				task.wait(CFG.TICK)
			end
			if loopId == myLoop then stop() end
		end)
	end

	-- a quick click still gives a short burst, holding keeps it going
	local function release()
		if not holding then return end
		local id = pressId
		local left = 0.4 - (os.clock() - startedAt)
		if left > 0 then
			task.delay(left, function()
				if pressId == id then stop() end
			end)
		else
			stop()
		end
	end

	bind(tool.Activated, start)
	bind(tool.Deactivated, release)
	bind(UserInputService.InputBegan, function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then start() end
	end)
	bind(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then release() end
	end)

	-- phone fire button
	local fireGui
	if UserInputService.TouchEnabled then
