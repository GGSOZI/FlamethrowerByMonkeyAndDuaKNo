------------------------------------------------------------------ HELPERS
local function playSoundAt(parent, id, props)
	if type(id) == "number" then id = "rbxassetid://" .. id end
	if type(id) == "string" and string.match(id, "^%d+$") then id = "rbxassetid://" .. id end
	if not id or id == "" or not parent then return nil end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.RollOffMaxDistance = 140
	for k, v in pairs(props or {}) do s[k] = v end
	s.Parent = parent
	s:Play()
