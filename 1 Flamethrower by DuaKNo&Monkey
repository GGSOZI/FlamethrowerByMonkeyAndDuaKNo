		fireBtn.AutoButtonColor = true
		fireBtn.Parent = fireGui
		local fc = Instance.new("UICorner")
		fc.CornerRadius = UDim.new(0, 0)
		fc.Parent = fireBtn
		local fs = Instance.new("UIStroke")
		fs.Color = Color3.fromRGB(255, 160, 60)
		fs.Thickness = 2
		fs.Parent = fireBtn
		fireBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then start() end
		end)
		fireBtn.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then release() end
		end)
	end

	bind(tool.Equipped, function()
		local rig = rigOf[tool]
		if rig then setEquipped(rig, true) end
		if fireGui then fireGui.Enabled = true end
		setFuelHudVisible(true)
		setOut(true)
	end)
	bind(tool.Unequipped, function()
		stop()
		local rig = rigOf[tool]
		if rig then setEquipped(rig, false) end
		if fireGui then fireGui.Enabled = false end
		setFuelHudVisible(false)
		setOut(false)
	end)
	bind(tool.AncestryChanged, function()
		if not tool:IsDescendantOf(game) then
			stop()
			setOut(false)
			hooked[tool] = nil
			for _, c in ipairs(conns) do c:Disconnect() end
			if fireGui then fireGui:Destroy() end
			local rig = rigOf[tool]
			if rig then
				if activeRig == rig then activeRig = nil end
				if rig.model.Parent then rig.model:Destroy() end
				rigOf[tool] = nil
			end
			setFuelHudVisible(false)
		end
	end)

	if tool.Parent == getChar() then
		local rig = rigOf[tool]
		if rig then setEquipped(rig, true) end
		if fireGui then fireGui.Enabled = true end
		setFuelHudVisible(true)
		setOut(true)
	end
	notify("Flamethrower", "Equip it and hold click / FIRE.", 3)
end

