-- cframe for a flat disc lying on a surface: cylinder axis (local X) = normal, local Y = "down" along the surface
local function discCF(pos, normal, preferDown)
	local down = preferDown or Vector3.new(0, -1, 0)
	local t = down - normal * down:Dot(normal)
	if t.Magnitude < 0.05 then
		t = Vector3.xAxis - normal * Vector3.xAxis:Dot(normal)
		if t.Magnitude < 0.05 then t = Vector3.zAxis end
	end
	return CFrame.fromMatrix(pos, normal, t.Unit)
end

------------------------------------------------------------------ NETWORK OWNERSHIP + KILL (same method as the car spawner)
-- Raising the SimulationRadius makes the server hand you network ownership of the NPCs around you.
-- Once you own one, setting its Humanoid.Health to 0 on your client is what everyone sees.
-- The radius is only raised while the flamethrower is equipped and is restored when you put it away.
-- Needs an executor with sethiddenproperty; isnetworkowner is used to confirm ownership when it exists.
CFG.NET = { active = false, original = {}, lastWarn = 0 }
do
	local Net = CFG.NET
	local RADIUS = 1000

	function Net.apply()
		if not Net.active then return end
		if typeof(sethiddenproperty) == "function" then
			pcall(sethiddenproperty, player, "SimulationRadius", RADIUS)
			pcall(sethiddenproperty, player, "MaximumSimulationRadius", RADIUS)
		end
		pcall(function() player.MaximumSimulationRadius = RADIUS end)
	end

	function Net.restore()
		pcall(function()
			if Net.original.maxProp then player.MaximumSimulationRadius = Net.original.maxProp end
		end)
		if typeof(sethiddenproperty) ~= "function" then return end
		if Net.original.sim then pcall(sethiddenproperty, player, "SimulationRadius", Net.original.sim) end
		if Net.original.max then pcall(sethiddenproperty, player, "MaximumSimulationRadius", Net.original.max) end
	end

	do
		local okp, mp = pcall(function() return player.MaximumSimulationRadius end)
		if okp and type(mp) == "number" then Net.original.maxProp = mp end
		if typeof(gethiddenproperty) == "function" then
			local ok1, sr = pcall(gethiddenproperty, player, "SimulationRadius")
			local ok2, mr = pcall(gethiddenproperty, player, "MaximumSimulationRadius")
			if ok1 and type(sr) == "number" then Net.original.sim = sr end
			if ok2 and type(mr) == "number" then Net.original.max = mr end
		end
	end

	function Net.setActive(on)
		if on == Net.active then return end
		Net.active = on
		if on then Net.apply() else Net.restore() end
	end

	function Net.isOwner(part)
		if typeof(isnetworkowner) ~= "function" then return true end
		local ok, owned = pcall(isnetworkowner, part)
		return ok and owned == true
	end

	function Net.claim(root, timeout)
		if not root then return false end
		Net.apply()
		if typeof(isnetworkowner) ~= "function" then return true end
		local t = os.clock()
		while os.clock() - t < (timeout or 1.5) do
			if Net.isOwner(root) then return true end
			Net.apply()
			RunService.Heartbeat:Wait()
		end
		return Net.isOwner(root)
	end

	function Net.killNow(model)
		pcall(function()
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("Humanoid") then d.Health = 0 end
			end
		end)
	end

	-- real kill: Health = 0 right away, claim ownership, then keep it for a few seconds so it replicates
	function Net.kill(model)
		Net.killNow(model)
		task.spawn(function()
			local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			if root and not Net.claim(root, 1.5) and os.clock() - Net.lastWarn > 6 then
				Net.lastWarn = os.clock()
				notify("Flamethrower", "Couldn't get ownership of that NPC, other players may not see it die.", 4)
			end
			local t0 = os.clock()
			while os.clock() - t0 < 4 and model.Parent do
				Net.apply()
				Net.killNow(model)
				task.wait(0.5)
			end
		end)
	end
end

