------------------------------------------------------------------ RE-EXECUTE: REMOVE THE PREVIOUS COPY
-- Running the script again first stops the old copy: connections, render steps, menus, HUDs, rig, NPCs and effects.
-- (no new top-level locals here: Luau caps them at 200, so the state lives in CFG.FT)
do
	local env = (typeof(getgenv) == "function" and getgenv()) or _G
	local Lighting = game:GetService("Lighting")
	local FT = { stopped = false, conns = {}, bound = {}, cleanups = {} }

	local function wipe()
		local hosts = { player:FindFirstChildOfClass("PlayerGui") }
		pcall(function()
			if typeof(gethui) == "function" then table.insert(hosts, gethui()) end
		end)
		for _, host in ipairs(hosts) do
			for _, g in ipairs(host:GetChildren()) do
				if g:IsA("ScreenGui") and (string.find(g.Name, "^Flamethrower") or g.Name == "BegCinema") then
					g:Destroy()
				end
			end
		end
		for _, n in ipairs({ "BegGrade", "BegFocus" }) do
			local e = Lighting:FindFirstChild(n)
			if e then e:Destroy() end
		end
		local ch = player.Character
		if ch then
			for _, d in ipairs(ch:GetDescendants()) do
				if d.Name == "FlamethrowerRig" then d:Destroy() end
			end
			local hum = ch:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.AutoRotate = true
				hum.CameraOffset = Vector3.zero
			end
		end
		for _, d in ipairs(Workspace:GetChildren()) do
			if d.Name == "FlamethrowerFX" or d.Name == "FlamethrowerRig" or d:GetAttribute("FlamethrowerStation") then
				d:Destroy()
			end
		end
		-- the built-in wand is built together with its rig, so it is removed too and the new copy builds both again
		-- (otherwise the old tool is left without a gun)
		for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), ch }) do
			if container then
				for _, t in ipairs(container:GetChildren()) do
					if t:IsA("Tool") and (t:GetAttribute("FlamethrowerBuiltin")
						or (t.RequiresHandle == false and string.find(string.lower(t.Name), "flame") and not t:FindFirstChildWhichIsA("BasePart", true))) then
						t:Destroy()
					end
				end
			end
		end
		pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
	end

	-- wraps a service so every signal connection and render step made through it can be undone later
	local function track(svc)
		return setmetatable({}, {
			__index = function(_, k)
				local v = svc[k]
				if typeof(v) == "RBXScriptSignal" then
					return {
						Connect = function(_, fn)
							local c = v:Connect(fn)
							table.insert(FT.conns, c)
							return c
						end,
						Once = function(_, fn)
							local c = v:Once(fn)
							table.insert(FT.conns, c)
							return c
						end,
						Wait = function() return v:Wait() end,
					}
				elseif type(v) == "function" then
					if k == "BindToRenderStep" then
						return function(_, name, ...)
							table.insert(FT.bound, name)
							return v(svc, name, ...)
						end
					end
					return function(_, ...) return v(svc, ...) end
				end
				return v
			end,
			__newindex = function(_, k, val) svc[k] = val end,
		})
	end

	local prev = env.__FlamethrowerStop
	if type(prev) == "function" then pcall(prev) end
	wipe()

	env.__FlamethrowerStop = function()
		FT.stopped = true
		for _, c in ipairs(FT.conns) do pcall(function() c:Disconnect() end) end
		for _, n in ipairs(FT.bound) do pcall(function() RunService:UnbindFromRenderStep(n) end) end
		for _, f in ipairs(FT.cleanups) do pcall(f) end
		wipe()
	end

	RunService = track(RunService)
	UserInputService = track(UserInputService)
	CFG.FT = FT
end

