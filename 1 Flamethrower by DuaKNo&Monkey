-- what the next execution has to undo that only this copy knows about
table.insert(CFG.FT.cleanups, function()
	pcall(function() CFG.NET.setActive(false) end)
	pcall(function() setShiftLock(false) end)
	for _, m in ipairs(spawned) do
		pcall(function()
			local st = burning[m]
			if st then removeFire(st) end
			if m.Parent then m:Destroy() end
		end)
	end
	for _, rig in pairs(rigOf) do
		pcall(function()
			if rig.model and rig.model.Parent then rig.model:Destroy() end
		end)
	end
	for _, it in ipairs(fxItems) do
		pcall(function() if it.part.Parent then it.part:Destroy() end end)
	end
end)
