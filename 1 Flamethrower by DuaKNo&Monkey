------------------------------------------------------------------ RAGDOLL
local function ragdoll(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or ragdollData[model] then return end
	local data = { objs = {}, motors = {}, phys = {} }
	ragdollData[model] = data

	hum.PlatformStand = true
	hum.AutoRotate = false
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)

	for _, m in ipairs(model:GetDescendants()) do
		-- the root joint stays on: HumanoidRootPart is welded to the torso instead of dangling on its own joint (that jittered)
		if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Enabled and m.Part0.Name ~= "HumanoidRootPart" then
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.CFrame = m.C0
			a1.CFrame = m.C1
			a0.Parent = m.Part0
			a1.Parent = m.Part1
			local b = Instance.new("BallSocketConstraint")
			b.Attachment0 = a0
			b.Attachment1 = a1
			b.LimitsEnabled = true
			b.UpperAngle = 65
			b.TwistLimitsEnabled = true
			b.TwistLowerAngle = -40
			b.TwistUpperAngle = 40
			b.Restitution = 0
			b.MaxFrictionTorque = 4          -- a little friction so the limbs settle instead of buzzing
			b.Parent = m.Part0
			-- neighbouring parts overlap at the joint, they must not push each other apart
			local nc = Instance.new("NoCollisionConstraint")
			nc.Part0 = m.Part0
			nc.Part1 = m.Part1
			nc.Parent = m.Part0
			m.Enabled = false
			table.insert(data.motors, m)
			table.insert(data.objs, a0)
			table.insert(data.objs, a1)
			table.insert(data.objs, b)
			table.insert(data.objs, nc)
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(data.phys, { d, d.CustomPhysicalProperties })
			d.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.7, 0, 1, 1)   -- no bounce
			if string.find(d.Name, "Hand") or string.find(d.Name, "Foot") then d.CanCollide = false end
		end
	end
	for _, n in ipairs({ "Head", "UpperTorso", "LowerTorso", "Torso" }) do
		local p = model:FindFirstChild(n)
		if p then p.CanCollide = true end
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then root.CanCollide = false end
end

local function unragdoll(model)
	local data = ragdollData[model]
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not data or not hum or not root then return end
	ragdollData[model] = nil
	for _, o in ipairs(data.objs) do
		if o.Parent then o:Destroy() end
	end
	for _, m in ipairs(data.motors) do
		if m.Parent then m.Enabled = true end
	end
	for _, e in ipairs(data.phys or {}) do
		if e[1].Parent then e[1].CustomPhysicalProperties = e[2] end
	end
	local _, yaw = root.CFrame:ToEulerAnglesYXZ()
	model:PivotTo(CFrame.new(root.Position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, yaw, 0))
	hum.PlatformStand = false
	hum.AutoRotate = true
	hum.WalkSpeed = 9
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
end

local function flail(model, strength)
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if root then
		local s = strength or 1
		root.AssemblyAngularVelocity = Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5)) * s
		root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new(math.random(-3, 3) * s, math.random(2, 6) * s, math.random(-3, 3) * s)
	end
end

