			local bar = make("Frame", {
				Position = UDim2.fromOffset(44 + (i - 1) * 18, 96), Size = UDim2.fromOffset(14, 6), BorderSizePixel = 0,
				BackgroundColor3 = i <= lag and accent or Color3.fromRGB(58, 58, 64),
			}, b)
			make("UICorner", { CornerRadius = UDim.new(0, 3) }, bar)
		end

		local function tweenTo(bg, tr)
			TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = bg }):Play()
			TweenService:Create(stroke, TweenInfo.new(0.12), { Transparency = tr }):Play()
		end
		b.MouseEnter:Connect(function() tweenTo(Color3.fromRGB(42, 42, 49), 0) end)
		b.MouseLeave:Connect(function() tweenTo(Color3.fromRGB(30, 30, 35), 0.78) end)
		b.Activated:Connect(function()
			if chosen then return end
			chosen = key
			picked:Fire(key)
		end)
