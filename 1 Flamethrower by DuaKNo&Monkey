local function ropeLayout(rig)
	local t0 = rig.torso.CFrame
	local pa = (t0 * CFrame.new(0.3, 0, -1.8)).Position
	local pb = (t0 * CFrame.new(1.9, -0.7, -0.4)).Position
	local pc = (t0 * CFrame.new(1.9, -0.7, 0.7)).Position
	local pd = (rig.root.CFrame * CFrame.new(0.45, -0.1, -0.25)).Position
	local r = rig.rope
	for i = 1, r.n do
		local t = (i - 1) / (r.n - 1)
		local u = 1 - t
		local pt = (u * u * u) * pa + (3 * u * u * t) * pb + (3 * u * t * t) * pc + (t * t * t) * pd
		r.pts[i] = pt
		r.prev[i] = pt
	end
end

